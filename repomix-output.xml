      const organizationId = req.organizationId;

      const enabledFlags = await featureFlagService.getEnabledFlags({
        userId,
        organizationId,
      });

      res.json({ enabledFlags });
    } catch (error) {
      next(error);
    }
  }
);

/**
 * POST /api/features
