          <NotificationChannelToggle
            icon={<Bell className="h-5 w-5" />}
            title={t('channels.push')}
            description={t('channels.pushDesc')}
            enabled={preferences.pushEnabled}
            onChange={(enabled) => savePreferences({ pushEnabled: enabled })}
