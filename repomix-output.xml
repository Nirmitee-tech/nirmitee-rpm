    try {
      const { key } = req.params;
      const flag = await featureFlagService.getFlag(key);

      if (!flag) {
        throw new ApiError(404, `Feature flag ${key} not found`);
      }

      res.json({ flag });
    } catch (error) {
      next(error);
    }
  }
);

