// Prisma schema for NirmiteeRPM
// Production-grade RBAC with multi-tenancy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORGANIZATION (Multi-tenancy)
// ============================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  settings    Json?    @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members       OrganizationMember[]
  teams         Team[]
  roles         Role[]
  invitations   Invitation[]
  authProviders AuthProvider[]
  subscription  Subscription?
  files         File[]

  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@map("organization_members")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MfaMethod {
  TOTP   // Authenticator app
  EMAIL  // Email OTP
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   // Optional for OAuth-only users
  firstName     String
  lastName      String
  avatar        String?
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // MFA (Multi-Factor Authentication)
  mfaEnabled      Boolean   @default(false)
  mfaMethod       MfaMethod? // TOTP or EMAIL
  mfaSecret       String?   // TOTP secret (encrypted)
  mfaBackupCodes  String[]  // Hashed backup codes
  mfaEnabledAt    DateTime?

  // Email OTP
  emailOtpCode      String?   // Current OTP code (hashed)
  emailOtpExpiresAt DateTime? // OTP expiration time

  // Relations
  organizations       OrganizationMember[]
  teamMembers         TeamMember[]
  sessions            Session[]
  passwordResets      PasswordReset[]
  notifications       Notification[]
  notificationPreference NotificationPreference?
  authProviders       UserAuthProvider[]

  // RPM Relations
  patient                    Patient?
  caregiver                  Caregiver?
  patientsAsPrimaryPhysician Patient[]           @relation("PrimaryPhysician")
  patientsAsAssignedStaff    Patient[]           @relation("AssignedClinicalStaff")
  alertsAssigned             Alert[]             @relation("AlertAssignedTo")
  alertsEscalated            Alert[]             @relation("AlertEscalatedTo")
  alertsAcknowledged         Alert[]             @relation("AlertAcknowledgedBy")
  carePlansCreated           CarePlan[]          @relation("CarePlanCreatedBy")
  carePlansApproved          CarePlan[]          @relation("CarePlanApprovedBy")
  billableActivities         BillableActivity[]
  uploadedFiles              File[]

  @@index([email])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ============================================
// OAUTH PROVIDERS (Extensible SSO)
// ============================================

model AuthProvider {
  id             String              @id @default(cuid())
  organizationId String?             // null = global, otherwise org-specific
  provider       OAuthProviderType
  name           String              // Display name (e.g., "Google Workspace", "Microsoft Entra ID")
  clientId       String
  clientSecret   String              // Encrypted in production
  tenantId       String?             // For Microsoft/Azure AD
  domain         String?             // For Google Workspace domain restriction
  scopes         String[]            @default(["openid", "email", "profile"])
  enabled        Boolean             @default(true)
  autoProvision  Boolean             @default(false) // Auto-create users on first login
  defaultRoleId  String?             // Role to assign to auto-provisioned users
  settings       Json?               @default("{}") // Provider-specific settings
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultRole    Role?               @relation(fields: [defaultRoleId], references: [id])
  userAccounts   UserAuthProvider[]

  @@unique([organizationId, provider])
  @@index([provider])
  @@index([enabled])
  @@map("auth_providers")
}

model UserAuthProvider {
  id             String          @id @default(cuid())
  userId         String
  providerId     String
  providerUserId String          // External user ID from OAuth provider
  email          String          // Email from OAuth provider
  accessToken    String?         // OAuth access token (encrypted)
  refreshToken   String?         // OAuth refresh token (encrypted)
  tokenExpiresAt DateTime?
  profile        Json?           // Raw profile data from provider
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AuthProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerUserId])
  @@unique([userId, providerId])
  @@index([userId])
  @@index([email])
  @@map("user_auth_providers")
}

enum OAuthProviderType {
  GOOGLE
  MICROSOFT
  GITHUB
  OKTA
  AUTH0
  SAML // For future SAML/SSO support
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  organizationId String
  roleId         String
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String?
  createdAt      DateTime         @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============================================
// TEAM MANAGEMENT
// ============================================

model Team {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

enum TeamRole {
  LEAD
  MEMBER
}

// ============================================
// RBAC - Role Based Access Control
// ============================================

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String?  // null = system role, not null = custom org role
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization  Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  members       OrganizationMember[]
  invitations   Invitation[]
  authProviders AuthProvider[]       // Default role for OAuth auto-provisioned users

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "users:read", "teams:write", "dashboard:view"
  name        String
  description String?
  module      String   // e.g., "users", "teams", "dashboard", "reports"
  action      String   // e.g., "read", "write", "delete", "manage"
  createdAt   DateTime @default(now())

  // Relations
  roles RolePermission[]

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// AUDIT LOG (for production tracking)
// ============================================

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String   // e.g., "user.created", "role.updated"
  entity         String   // e.g., "user", "role", "team"
  entityId       String?
  oldValues      Json?    // Previous state for updates
  newValues      Json?    // New state for creates/updates
  metadata       Json?    // Additional context
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ============================================
// ACTIVITY FEED (User-friendly timeline)
// ============================================

model Activity {
  id             String    @id @default(cuid())
  organizationId String
  actorId        String    // User who performed the action
  actorType      ActorType @default(USER)
  action         String    // e.g., "created", "updated", "deleted"
  entityType     String    // e.g., "user", "team", "patient", "alert"
  entityId       String
  entityName     String?   // For display: "John Doe", "Team Alpha"
  metadata       Json?     // Additional context
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([actorId, createdAt])
  @@index([organizationId, entityType, createdAt])
  @@map("activities")
}

enum ActorType {
  USER
  SYSTEM
  API
}

// ============================================
// NOTIFICATIONS (Real-time)
// ============================================

model Notification {
  id             String             @id @default(cuid())
  userId         String
  organizationId String?
  type           NotificationType
  title          String
  message        String
  data           Json?              // Additional data for the notification
  isRead         Boolean            @default(false)
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  TEAM_INVITE
  ROLE_CHANGE
  USER_ADDED
  USER_REMOVED
  SYSTEM
  ALERT_CRITICAL
  ALERT_SIGNIFICANT
  CARE_PLAN_UPDATED
}

// ============================================
// NOTIFICATION PREFERENCES
// ============================================

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification channels
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  inAppEnabled    Boolean  @default(true)

  // Notification types
  securityAlerts  Boolean  @default(true)
  teamUpdates     Boolean  @default(true)
  systemUpdates   Boolean  @default(true)
  marketingEmails Boolean  @default(false)
  weeklyDigest    Boolean  @default(true)

  // Quiet hours
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String?  // "22:00"
  quietHoursEnd     String?  // "08:00"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("notification_preferences")
}

// ============================================
// RPM - PATIENT MANAGEMENT
// ============================================

model Patient {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  organizationId           String
  dateOfBirth              DateTime
  phone                    String?
  address                  Json?              // { street, city, state, zip, country }
  conditions               PatientCondition[]
  insuranceProvider        String?
  insurancePolicyNumber    String?
  enrollmentStatus         EnrollmentStatus   @default(PENDING)
  enrollmentDate           DateTime?
  primaryPhysicianId       String?            // User ID of physician
  assignedClinicalStaffId  String?            // User ID of clinical staff
  deletedAt                DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryPhysician  User?              @relation("PrimaryPhysician", fields: [primaryPhysicianId], references: [id])
  clinicalStaff     User?              @relation("AssignedClinicalStaff", fields: [assignedClinicalStaffId], references: [id])
  devices           Device[]
  vitalReadings     VitalReading[]
  alerts            Alert[]
  carePlans         CarePlan[]
  caregiverLinks    CaregiverLink[]
  billingRecords    BillingRecord[]

  @@index([organizationId])
  @@index([userId])
  @@index([enrollmentStatus])
  @@index([deletedAt])
  @@index([primaryPhysicianId])
  @@index([assignedClinicalStaffId])
  @@index([organizationId, enrollmentStatus])
  @@map("patients")
}

model Caregiver {
  id             String          @id @default(cuid())
  userId         String          @unique
  organizationId String
  phone          String?
  relationship   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientLinks   CaregiverLink[]

  @@index([organizationId])
  @@index([userId])
  @@map("caregivers")
}

model CaregiverLink {
  id                  String              @id @default(cuid())
  patientId           String
  caregiverId         String
  organizationId      String              // Required for multi-tenant RLS
  relationshipType    RelationshipType
  accessLevel         CaregiverAccessLevel @default(VIEW_VITALS)
  status              CaregiverLinkStatus  @default(PENDING)
  consentGrantedAt    DateTime?
  consentRevokedAt    DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@unique([patientId, caregiverId])
  @@index([patientId])
  @@index([caregiverId])
  @@index([organizationId])
  @@index([status])
  @@map("caregiver_links")
}

enum PatientCondition {
  HYPERTENSION
  CONGESTIVE_HEART_FAILURE
  DIABETES_TYPE_1
  DIABETES_TYPE_2
  COPD
  CHRONIC_KIDNEY_DISEASE
  ARRHYTHMIA
  PRE_DIABETES
  OBESITY
  ASTHMA
  POST_COVID
  POST_SURGICAL
  OTHER
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  DISCHARGED
}

enum RelationshipType {
  SPOUSE_PARTNER
  ADULT_CHILD
  PARENT
  SIBLING
  PROFESSIONAL_CAREGIVER
  LEGAL_GUARDIAN
  OTHER
}

enum CaregiverAccessLevel {
  VIEW_VITALS
  VIEW_ALERTS
  VIEW_CARE_PLAN
  FULL_ACCESS
}

enum CaregiverLinkStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

// ============================================
// RPM - DEVICE MANAGEMENT
// ============================================

model Device {
  id             String       @id @default(cuid())
  patientId      String
  organizationId String
  type           DeviceType
  serialNumber   String
  manufacturer   String?
  model          String?
  status         DeviceStatus @default(ACTIVE)
  lastSyncAt     DateTime?
  assignedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vitalReadings VitalReading[]

  @@unique([serialNumber])
  @@index([patientId])
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([organizationId, patientId])
  @@map("devices")
}

enum DeviceType {
  BLOOD_PRESSURE_MONITOR
  WEIGHT_SCALE
  PULSE_OXIMETER
  GLUCOSE_MONITOR
  CONTINUOUS_GLUCOSE_MONITOR
  THERMOMETER
  ACTIVITY_TRACKER
  ECG_MONITOR
  OTHER
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MALFUNCTIONING
  DECOMMISSIONED
}

// ============================================
// RPM - VITAL READINGS
// ============================================

model VitalReading {
  id             String     @id @default(cuid())
  patientId      String
  organizationId String
  deviceId       String?
  type           VitalType
  values         Json       // e.g., { systolic: 140, diastolic: 90, pulse: 72 }
  unit           String
  source         DataSource @default(DEVICE)
  recordedAt     DateTime   // When the reading was taken
  receivedAt     DateTime   @default(now()) // When system received it
  notes          String?
  createdAt      DateTime   @default(now())

  // Relations
  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  device  Device?  @relation(fields: [deviceId], references: [id])
  alerts  Alert[]

  @@index([patientId])
  @@index([organizationId])
  @@index([type])
  @@index([recordedAt])
  @@index([deviceId])
  @@index([patientId, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([patientId, type, recordedAt])
  @@map("vital_readings")
}

enum VitalType {
  BLOOD_PRESSURE
  WEIGHT
  BLOOD_GLUCOSE
  PULSE_OXIMETRY
  HEART_RATE
  TEMPERATURE
  RESPIRATORY_RATE
  BMI
}

enum DataSource {
  DEVICE
  MANUAL
  EHR_IMPORT
  CAREGIVER_ENTRY
}

// ============================================
// RPM - ALERTS
// ============================================

model Alert {
  id              String         @id @default(cuid())
  patientId       String
  organizationId  String
  vitalReadingId  String?
  type            AlertType
  severity        AlertSeverity
  status          AlertStatus    @default(NEW)
  message         String
  metadata        Json?          // Additional context
  assignedToId    String?        // Clinical staff
  escalatedToId   String?        // Physician
  acknowledgedAt  DateTime?
  acknowledgedById String?
  escalatedAt     DateTime?
  resolvedAt      DateTime?
  resolution      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vitalReading   VitalReading?  @relation(fields: [vitalReadingId], references: [id])
  assignedTo     User?          @relation("AlertAssignedTo", fields: [assignedToId], references: [id])
  escalatedTo    User?          @relation("AlertEscalatedTo", fields: [escalatedToId], references: [id])
  acknowledgedBy User?          @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([patientId])
  @@index([organizationId])
  @@index([severity])
  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([escalatedToId])
  @@index([createdAt])
  @@index([organizationId, status])
  @@index([patientId, status])
  @@index([assignedToId, status])
  @@map("alerts")
}

enum AlertType {
  THRESHOLD_EXCEEDED
  TREND_CONCERNING
  ADHERENCE_LOW
  DEVICE_MALFUNCTION
  MISSED_READING
  CRITICAL_VALUE
  SYSTEM_GENERATED
}

enum AlertSeverity {
  CRITICAL
  SIGNIFICANT
  INFORMATIONAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
  DISMISSED
}

// ============================================
// RPM - CARE PLANS
// ============================================

model CarePlan {
  id             String            @id @default(cuid())
  patientId      String
  organizationId String
  createdById    String            // User who created
  approvedById   String?           // Physician who approved
  currentVersion Int               @default(1)
  status         CarePlanStatus    @default(DRAFT)
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("CarePlanCreatedBy", fields: [createdById], references: [id])
  approvedBy     User?             @relation("CarePlanApprovedBy", fields: [approvedById], references: [id])
  versions       CarePlanVersion[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@map("care_plans")
}

model CarePlanVersion {
  id                String   @id @default(cuid())
  carePlanId        String
  organizationId    String   // Required for multi-tenant RLS
  version           Int
  goals             Json     // Array of care goals
  vitalThresholds   Json     // Thresholds for each vital type
  medications       Json?    // Medication list
  instructions      String?
  effectiveDate     DateTime
  expiryDate        DateTime?
  createdAt         DateTime @default(now())

  // Relations
  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@unique([carePlanId, version])
  @@index([carePlanId])
  @@index([organizationId])
  @@index([effectiveDate])
  @@map("care_plan_versions")
}

enum CarePlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// ============================================
// RPM - BILLING
// ============================================

model BillingRecord {
  id                    String          @id @default(cuid())
  patientId             String
  organizationId        String
  periodStart           DateTime
  periodEnd             DateTime
  dataTransmissionDays  Int             @default(0)
  interactionMinutes    Int             @default(0)
  status                BillingStatus   @default(PENDING)
  claimId               String?
  claimSubmittedAt      DateTime?
  paidAt                DateTime?
  amount                Float?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  activities BillableActivity[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([organizationId, periodStart])
  @@map("billing_records")
}

model BillableActivity {
  id               String        @id @default(cuid())
  billingRecordId  String
  organizationId   String        // Required for multi-tenant RLS
  cptCode          CPTCode
  performedById    String        // User who performed activity
  performedAt      DateTime
  durationMinutes  Int?          // For time-based codes
  description      String?
  metadata         Json?
  createdAt        DateTime      @default(now())

  // Relations
  billingRecord BillingRecord @relation(fields: [billingRecordId], references: [id], onDelete: Cascade)
  performedBy   User          @relation(fields: [performedById], references: [id])

  @@index([billingRecordId])
  @@index([organizationId])
  @@index([cptCode])
  @@index([performedById])
  @@index([performedAt])
  @@map("billable_activities")
}

enum CPTCode {
  CPT_99453 // Initial setup & patient education
  CPT_99445 // Device supply 2-15 days (NEW 2026)
  CPT_99454 // Device supply 16+ days
  CPT_99470 // Treatment management 10 min real-time (NEW 2026)
  CPT_99457 // Treatment management 20-39 min
  CPT_99458 // Additional management 20 min
}

enum BillingStatus {
  PENDING
  ELIGIBLE
  SUBMITTED
  ACCEPTED
  DENIED
  PAID
  APPEALED
}

// ============================================
// SUBSCRIPTION & BILLING (Stripe)
// ============================================

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([stripeCustomerId])
  @@index([status])
  @@index([organizationId])
  @@map("subscriptions")
}

model Invoice {
  id                 String        @id @default(cuid())
  subscriptionId     String
  organizationId     String        // Denormalized for multi-tenant queries
  stripeInvoiceId    String        @unique
  amount             Int           // Amount in cents
  currency           String        @default("usd")
  status             InvoiceStatus
  paidAt             DateTime?
  invoiceUrl         String?
  invoicePdf         String?
  createdAt          DateTime      @default(now())

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model PricingPlan {
  id            String          @id @default(cuid())
  name          String
  description   String?
  stripePriceId String          @unique
  amount        Int             // Amount in cents
  currency      String          @default("usd")
  interval      BillingInterval
  features      Json            // Array of feature strings
  limits        Json            // { users: 10, storage: "5GB", patients: 100 }
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("pricing_plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingInterval {
  MONTH
  YEAR
}

// ============================================
// FILE STORAGE
// ============================================

model File {
  id             String   @id @default(cuid())
  organizationId String
  uploadedBy     String
  key            String   @unique
  filename       String
  contentType    String
  size           Int
  metadata       Json?    @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([uploadedBy])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("files")
}

// ============================================
// FEATURE FLAGS
// ============================================

model FeatureFlag {
  id             String             @id @default(cuid())
  key            String             @unique
  name           String
  description    String?
  enabled        Boolean            @default(false)
  targetType     FeatureFlagTarget  @default(GLOBAL)
  targetIds      String[]           // organizationIds or userIds
  percentage     Int?               // For gradual rollout (0-100)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([key])
  @@index([enabled])
  @@map("feature_flags")
}

enum FeatureFlagTarget {
  GLOBAL          // All users
  ORGANIZATION    // Specific orgs
  USER            // Specific users
  PERCENTAGE      // Random percentage
}

// ============================================
// BACKUP & DISASTER RECOVERY
// ============================================

model Backup {
  id            String   @id @default(cuid())
  type          BackupType
  status        BackupStatus @default(PENDING)
  size          BigInt?
  location      String?  // S3 path or local path
  metadata      Json?
  error         String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  createdBy     String?

  @@index([status])
  @@index([type])
  @@index([startedAt])
  @@index([createdAt: startedAt])
  @@map("backups")
}

enum BackupType {
  DATABASE
  FILES
  FULL
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  VERIFIED
}
</file>

