 */
router.get(
  '/check/:key',
  authenticate,
  async (req, res, next) => {
    try {
      const { key } = req.params;
      const userId = req.user?.userId;
      const organizationId = req.organizationId;

      const enabled = await featureFlagService.isEnabled(key, {
        userId,
        organizationId,
      });

      res.json({ enabled, key });
    } catch (error) {
      next(error);
    }
  }
);

