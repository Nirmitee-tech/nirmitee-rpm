# ====================================
# NirmiteeRPM Web Frontend - Environment Configuration
# ====================================
# Copy this file to .env.local and update with your values
# NEVER commit .env.local files with real secrets to version control

# ====================================
# Application Configuration
# ====================================

# API backend URL
# This should point to your NirmiteeRPM API server
# Development: http://localhost:4000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL (usually same as API URL)
# The WebSocket connection will use this URL for real-time features
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ====================================
# Application Metadata
# ====================================

# Application name (displayed in browser title, emails, etc.)
NEXT_PUBLIC_APP_NAME="NirmiteeRPM"

# Application version (optional)
# NEXT_PUBLIC_APP_VERSION="1.0.0"

# Application environment (development, staging, production)
# NEXT_PUBLIC_APP_ENV=development

# ====================================
# Feature Flags (Optional)
# ====================================

# Enable/disable features in the frontend
# NEXT_PUBLIC_FEATURE_MFA_ENABLED=true
# NEXT_PUBLIC_FEATURE_OAUTH_ENABLED=true
# NEXT_PUBLIC_FEATURE_BILLING_ENABLED=true
# NEXT_PUBLIC_FEATURE_ACTIVITY_FEED_ENABLED=true
# NEXT_PUBLIC_FEATURE_WEBSOCKET_ENABLED=true
# NEXT_PUBLIC_FEATURE_DARK_MODE_ENABLED=true

# ====================================
# OAuth Configuration (Optional)
# ====================================

# Enable OAuth providers in login/signup UI
# NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
# NEXT_PUBLIC_OAUTH_MICROSOFT_ENABLED=false
# NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=false
# NEXT_PUBLIC_OAUTH_OKTA_ENABLED=false

# ====================================
# Stripe Configuration (Optional)
# ====================================

# Stripe publishable key (safe to expose in frontend)
# Get from: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_...) for development
# Use live keys (pk_live_...) for production
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdefghijklmnopqrstuvwxyz

# ====================================
# Analytics & Monitoring (Optional)
# ====================================

# Google Analytics measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ====================================
# Error Tracking & APM (Sentry)
# ====================================

# Sentry DSN for frontend error tracking
# Get from: https://sentry.io/settings/projects/
# Leave empty to disable Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Sentry environment name (should match backend)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Percentage of transactions to trace (0.0 - 1.0)
# Production: 0.1 (10%), Development: 1.0 (100%)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ====================================
# Product Analytics (Optional)
# ====================================

# PostHog project API key for product analytics
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ====================================
# Map Integration (Optional)
# ====================================

# Google Maps API key (if using maps for location features)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Mapbox access token (alternative to Google Maps)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-token

# ====================================
# Internationalization (i18n)
# ====================================

# Default language/locale
# NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supported locales (comma-separated)
# NEXT_PUBLIC_SUPPORTED_LOCALES=en,hi

# ====================================
# UI Configuration (Optional)
# ====================================

# Brand color (primary theme color)
# NEXT_PUBLIC_BRAND_COLOR=#745EE1

# Logo URL (if hosting logo externally)
# NEXT_PUBLIC_LOGO_URL=https://yourdomain.com/logo.png

# Favicon URL (if hosting favicon externally)
# NEXT_PUBLIC_FAVICON_URL=https://yourdomain.com/favicon.ico

# ====================================
# Development Tools
# ====================================

# Enable debug mode (shows additional dev info)
# NEXT_PUBLIC_DEBUG_MODE=false

# Enable React Query Devtools
# NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true

# ====================================
# Security Configuration (Optional)
# ====================================

# Content Security Policy report URI
# NEXT_PUBLIC_CSP_REPORT_URI=https://yourdomain.com/api/csp-report

# Enable strict mode for development
# NEXT_PUBLIC_STRICT_MODE=true
