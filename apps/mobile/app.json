{
  "expo": {
    "name": "NirmiteeRPM",
    "slug": "nirmitee-rpm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nirmitee",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#745EE1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nirmitee.rpm",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed for video calls with your care team.",
        "NSMicrophoneUsageDescription": "Microphone access is needed for video calls with your care team.",
        "NSFaceIDUsageDescription": "Face ID is used for secure app authentication."
      }
    },
    "android": {
      "package": "com.nirmitee.rpm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#745EE1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
