# ====================================
# NirmiteeRPM API - Environment Configuration
# ====================================
# Copy this file to .env and update with your values
# NEVER commit .env files with real secrets to version control

# ====================================
# Application Configuration
# ====================================

# Server port
PORT=4000

# Node environment (development, production, test)
NODE_ENV=development

# Frontend URL for CORS configuration
# Used to allow requests from your frontend application
FRONTEND_URL=http://localhost:3000

# API URL (used in emails and webhooks)
API_URL=http://localhost:4000

# ====================================
# Database Configuration
# ====================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Example for local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nirmitee_rpm?schema=public"

# Example for production (use connection pooling):
# DATABASE_URL="postgresql://user:password@db.example.com:5432/nirmitee_rpm?schema=public&connection_limit=10"

# ====================================
# JWT Authentication
# ====================================

# Secret key for signing access tokens (CHANGE IN PRODUCTION!)
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Secret key for signing refresh tokens (CHANGE IN PRODUCTION!)
# Generate a different strong random string: openssl rand -base64 32
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# Access token expiration time (e.g., 15m, 1h, 2h)
JWT_EXPIRES_IN="15m"

# Refresh token expiration time (e.g., 7d, 30d, 90d)
JWT_REFRESH_EXPIRES_IN="7d"

# ====================================
# Redis Configuration (Optional but Recommended)
# ====================================

# Redis connection URL (for caching and job queues)
# Format: redis://[:password@]host[:port][/database]
# Leave empty if Redis is not available (app will work without caching)
REDIS_URL="redis://localhost:6379"

# Alternative: Individual Redis configuration
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ====================================
# Email Configuration (SMTP)
# ====================================

# SMTP server host
# Development: Use MailHog (localhost:1025) or Mailpit for local email testing
# Production: Use your email provider (Gmail, SendGrid, AWS SES, etc.)
SMTP_HOST=localhost

# SMTP server port
# Common ports: 25 (unencrypted), 587 (TLS), 465 (SSL), 1025 (MailHog)
SMTP_PORT=1025

# Use TLS/SSL encryption (true/false)
SMTP_SECURE=false

# SMTP authentication username (required for production)
# SMTP_USER=your-email@example.com

# SMTP authentication password (required for production)
# SMTP_PASS=your-email-password

# Default "From" address for emails
SMTP_FROM="NirmiteeRPM <noreply@nirmiteerpm.local>"

# ====================================
# File Storage Configuration (S3-Compatible)
# ====================================

# S3 endpoint URL (use MinIO for local development)
# For AWS S3, leave empty or set to https://s3.amazonaws.com
# For MinIO (local): http://localhost:9000
S3_ENDPOINT=http://localhost:9000

# AWS region (e.g., us-east-1, us-west-2, eu-west-1)
S3_REGION=us-east-1

# S3 bucket name for file uploads
S3_BUCKET=nirmitee-uploads

# AWS access key ID or MinIO access key
S3_ACCESS_KEY=minioadmin

# AWS secret access key or MinIO secret key
S3_SECRET_KEY=minioadmin

# Force path-style URLs (required for MinIO, false for AWS S3)
S3_USE_PATH_STYLE=true

# Alternative AWS credentials (if using AWS SDK default chain)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# ====================================
# Stripe Payment Integration
# ====================================

# Stripe secret API key
# Get from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development
# Use live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyz

# Stripe publishable key (used in frontend, but kept here for reference)
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdefghijklmnopqrstuvwxyz

# Stripe webhook signing secret
# Get from: https://dashboard.stripe.com/webhooks
# Used to verify webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdefghijklmnopqrstuvwxyz

# ====================================
# OAuth 2.0 Configuration (Optional)
# ====================================

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/callback

# Microsoft OAuth (Azure AD / Entra ID)
# Get credentials from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# MICROSOFT_CLIENT_ID=your-client-id
# MICROSOFT_CLIENT_SECRET=your-client-secret
# MICROSOFT_TENANT_ID=your-tenant-id-or-common
# MICROSOFT_REDIRECT_URI=http://localhost:4000/api/oauth/callback

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-client-id
# GITHUB_CLIENT_SECRET=your-client-secret
# GITHUB_REDIRECT_URI=http://localhost:4000/api/oauth/callback

# Okta OAuth
# Get credentials from your Okta admin console
# OKTA_CLIENT_ID=your-client-id
# OKTA_CLIENT_SECRET=your-client-secret
# OKTA_DOMAIN=your-domain.okta.com
# OKTA_REDIRECT_URI=http://localhost:4000/api/oauth/callback

# ====================================
# Feature Flags (Optional)
# ====================================

# Enable/disable specific features
# FEATURE_MFA_ENABLED=true
# FEATURE_OAUTH_ENABLED=true
# FEATURE_BILLING_ENABLED=true
# FEATURE_ACTIVITY_FEED_ENABLED=true
# FEATURE_WEBSOCKET_ENABLED=true

# ====================================
# Rate Limiting Configuration (Optional)
# ====================================

# Maximum requests per window for API endpoints
# RATE_LIMIT_MAX=100

# Time window in minutes
# RATE_LIMIT_WINDOW_MS=900000

# Auth endpoints rate limit (stricter)
# AUTH_RATE_LIMIT_MAX=5
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# ====================================
# Logging Configuration (Optional)
# ====================================

# Log level (error, warn, info, debug)
# LOG_LEVEL=info

# Enable request logging
# LOG_REQUESTS=true

# ====================================
# Error Tracking & APM (Sentry)
# ====================================

# Sentry DSN (Data Source Name)
# Get from: https://sentry.io/settings/projects/
# Leave empty to disable Sentry error tracking
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Sentry environment name
# SENTRY_ENVIRONMENT=development

# Percentage of transactions to trace (0.0 - 1.0)
# Production: 0.1 (10%), Development: 1.0 (100%)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Percentage of transactions to profile (0.0 - 1.0)
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# ====================================
# Alerting & Monitoring
# ====================================

# Enable/disable alerting system
# ALERTS_ENABLED=true

# How often to check metrics for alerts (in seconds)
# ALERT_CHECK_INTERVAL=60

# Email recipients for alerts (comma-separated)
# ALERT_EMAIL_RECIPIENTS=admin@example.com,ops@example.com

# Slack webhook URL for alert notifications
# Get from: https://api.slack.com/messaging/webhooks
# ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel for alerts (optional, defaults to webhook default)
# ALERT_SLACK_CHANNEL=#alerts

# Slack username for alert bot (optional)
# ALERT_SLACK_USERNAME=NirmiteeRPM Alerts

# Slack icon emoji for alert bot (optional)
# ALERT_SLACK_ICON_EMOJI=:warning:

# Custom webhook URL for alert notifications
# ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# Custom webhook HTTP method (default: POST)
# ALERT_WEBHOOK_METHOD=POST

# Custom webhook headers (JSON format)
# ALERT_WEBHOOK_HEADERS={"Content-Type":"application/json","Authorization":"Bearer token"}

# Comma-separated list of alert rule IDs to disable
# ALERT_DISABLED_RULES=high-memory-usage,slow-database-queries

# ====================================
# Security Configuration
# ====================================

# CSRF Protection
# Enable/disable CSRF protection (enabled by default)
CSRF_PROTECTION_ENABLED=true

# Content Security Policy (CSP)
# Enable/disable CSP headers (enabled by default)
CSP_ENABLED=true

# CSP Report-Only Mode (true for development, false for production)
# In report-only mode, violations are logged but not blocked
CSP_REPORT_ONLY=true

# Input Sanitization
# Enable/disable automatic input sanitization (enabled by default)
INPUT_SANITIZATION_ENABLED=true

# API Key Settings
# Prefix for API keys (default: sk_)
API_KEY_PREFIX=sk_

# ====================================
# 100ms Video Telehealth Configuration
# ====================================

# 100ms App Access Key
# Get from: https://dashboard.100ms.live/developer
HMS_ACCESS_KEY=your-100ms-access-key

# 100ms App Secret
# Get from: https://dashboard.100ms.live/developer
HMS_SECRET=your-100ms-app-secret

# 100ms Template ID (optional - can create rooms without it)
# Get from: https://dashboard.100ms.live/templates
HMS_TEMPLATE_ID=your-template-id

# ====================================
# SMS Configuration (Twilio)
# ====================================

# Twilio Account SID
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Twilio Phone Number (for sending SMS)
TWILIO_FROM_NUMBER=+1234567890

# SMS Rate Limiting (per hour per user)
SMS_RATE_LIMIT_PER_HOUR=5

# ====================================
# Development Tools
# ====================================

# Enable Swagger API documentation
# ENABLE_SWAGGER=true

# Enable detailed error messages in responses (disable in production)
# SHOW_ERROR_DETAILS=true
