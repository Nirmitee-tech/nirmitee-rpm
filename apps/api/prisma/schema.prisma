// DeviceShipment - Shipping workflow
model DeviceShipment {
  id               String              @id @default(cuid())
  organizationId   String

  // Shipment info
  shipmentNumber   String
  shipmentType     ShipmentType

  // Recipient
  recipientType    String              // "patient", "facility", "warehouse"
  recipientId      String?             // Patient ID or facility ID
  recipientName    String

  // Address
  shippingAddress  Json                // { street, city, state, zip, country }

  // Carrier
  carrier          String?             // "UPS", "FedEx", "USPS"
  trackingNumber   String?
  shippingMethod   String?             // "Ground", "2-Day", "Overnight"

  // Dates
  requestedDate    DateTime            @default(now())
  shippedDate      DateTime?
  estimatedDelivery DateTime?
  actualDelivery   DateTime?

  // Return info (for returns)
  returnReason     String?
  returnTrackingNumber String?
  returnReceivedDate   DateTime?

  // Status
  status           ShipmentStatus      @default(PENDING)

  // Notes
  specialInstructions String?
  notes            String?

  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  items            DeviceShipmentItem[]

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId])
  @@index([status])
  @@index([recipientId])
  @@index([trackingNumber])
  @@map("device_shipments")
}

enum ShipmentType {
  OUTBOUND      // To patient/facility
  RETURN        // From patient
  TRANSFER      // Between facilities
  REPLACEMENT   // Replacement device
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_INITIATED
  RETURN_IN_TRANSIT
  RETURN_RECEIVED
  CANCELLED
}

// DeviceShipmentItem - Items in a shipment
model DeviceShipmentItem {
  id               String          @id @default(cuid())
  shipmentId       String
  inventoryId      String
  organizationId   String

  // Item details
  quantity         Int             @default(1)

  // Condition
  conditionOut     String?         // Condition when shipped
  conditionReturn  String?         // Condition when returned

  // Notes
  notes            String?

  // Relations
  shipment         DeviceShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  inventory        DeviceInventory @relation(fields: [inventoryId], references: [id])

  @@index([shipmentId])
  @@index([inventoryId])
  @@index([organizationId])
  @@map("device_shipment_items")
}

// TroubleshootingLog - Device troubleshooting records
model TroubleshootingLog {
  id               String              @id @default(cuid())
  inventoryId      String?
  deviceId         String?             // Active device if assigned
  patientId        String?
  organizationId   String

  // Issue
  issueType        TroubleshootingIssue
  issueDescription String
  severity         IssueSeverity       @default(MEDIUM)
  reportedBy       String              // "patient", "caregiver", "system", "staff"
  reportedAt       DateTime            @default(now())

  // Troubleshooting steps
  steps            Json?               // Array of steps taken

  // Resolution
  status           TroubleshootingStatus @default(OPEN)
  resolution       String?
  resolvedAt       DateTime?
  resolvedById     String?

  // Outcome
  deviceReplaced   Boolean             @default(false)
  replacementShipmentId String?

  // Related ticket
  ticketNumber     String?

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  inventory        DeviceInventory?    @relation(fields: [inventoryId], references: [id])

  @@index([organizationId])
  @@index([deviceId])
  @@index([patientId])
  @@index([status])
  @@index([issueType])
  @@index([reportedAt])
  @@map("troubleshooting_logs")
}

enum TroubleshootingIssue {
  NOT_SYNCING
  BATTERY_ISSUE
  DISPLAY_ERROR
  INACCURATE_READINGS
  CONNECTIVITY_ISSUE
  PHYSICAL_DAMAGE
  MISSING_PARTS
  USER_ERROR
  SOFTWARE_BUG
  OTHER
}

enum TroubleshootingStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_PATIENT
  WAITING_ON_PARTS
  RESOLVED
  ESCALATED
  CLOSED
}

// ResupplyTicket - Device/supply resupply requests
model ResupplyTicket {
  id               String              @id @default(cuid())
  organizationId   String
  patientId        String

  // Ticket info
  ticketNumber     String
  ticketType       ResupplyType

  // Items requested
  items            Json                // Array of { deviceType, quantity, reason }

  // Priority
  priority         ResupplyPriority    @default(NORMAL)

  // Status
  status           ResupplyStatus      @default(PENDING)

  // Approval
  approvalRequired Boolean             @default(false)
  approvedById     String?
  approvedAt       DateTime?

  // Fulfillment
  shipmentId       String?
  fulfilledAt      DateTime?

  // Notes
  requestReason    String?
  notes            String?

  requestedById    String
  requestedAt      DateTime            @default(now())

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([organizationId, ticketNumber])
  @@index([organizationId])
  @@index([patientId])
  @@index([status])
  @@index([priority])
  @@index([requestedAt])
  @@map("resupply_tickets")
}

enum ResupplyType {
  REPLACEMENT       // Replace broken/lost device
  ADDITIONAL        // Additional device needed
  CONSUMABLES       // Test strips, batteries, etc.
  UPGRADE           // Device upgrade
}

enum ResupplyPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ResupplyStatus {
  PENDING
  APPROVED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  DENIED
}

// ============================================
// COMPLIANCE & SECURITY HARDENING
// ============================================

// BaaAgreement - Business Associate Agreement management
model BaaAgreement {
  id               String          @id @default(cuid())
  organizationId   String

  // Parties
  partyName        String          // Business associate name
  partyType        BaaPartyType
  contactName      String?
  contactEmail     String?

  // Agreement details
  agreementNumber  String?
  version          String          @default("1.0")

  // Dates
  effectiveDate    DateTime
  expirationDate   DateTime?
  renewalDate      DateTime?

  // Document
  documentUrl      String?         // Signed BAA document

  // Status
  status           BaaStatus       @default(PENDING)
  signedAt         DateTime?
  signedById       String?

  // Audit
  lastReviewedAt   DateTime?
  lastReviewedById String?
  reviewNotes      String?

  // Notifications
  reminderSent     Boolean         @default(false)
  reminderSentAt   DateTime?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([expirationDate])
  @@map("baa_agreements")
}

enum BaaPartyType {
  CLEARINGHOUSE
  EHR_VENDOR
  CLOUD_PROVIDER
  DEVICE_MANUFACTURER
  ANALYTICS_PROVIDER
  STORAGE_PROVIDER
  COMMUNICATION_PROVIDER
  OTHER
}

enum BaaStatus {
  PENDING
  IN_REVIEW
  SIGNED
  EXPIRED
  TERMINATED
  RENEWAL_PENDING
}

// SecurityAuditLog - Security-specific audit logging
model SecurityAuditLog {
  id               String              @id @default(cuid())
  organizationId   String?

  // Event info
  eventType        SecurityEventType
  eventCategory    String              // "authentication", "authorization", "data_access"
  severity         SecuritySeverity    @default(INFO)

  // Actor
  userId           String?
  userEmail        String?
  ipAddress        String?
  userAgent        String?

  // Target
  resourceType     String?
  resourceId       String?

  // Details
  action           String
  result           String              // "success", "failure", "blocked"
  failureReason    String?

  // Context
  metadata         Json?

  createdAt        DateTime            @default(now())

  @@index([organizationId])
  @@index([eventType])
  @@index([userId])
  @@index([severity])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("security_audit_logs")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE
  API_KEY_CREATED
  API_KEY_REVOKED
  PERMISSION_CHANGE
  ROLE_CHANGE
  DATA_EXPORT
  DATA_ACCESS
  PHI_ACCESS
  SUSPICIOUS_ACTIVITY
  BRUTE_FORCE_DETECTED
  SESSION_TIMEOUT
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

enum SecuritySeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

// MfaEnforcement - MFA enforcement policies
model MfaEnforcement {
  id               String              @id @default(cuid())
  organizationId   String              @unique

  // Enforcement level
  enforcementLevel MfaEnforcementLevel @default(OPTIONAL)

  // Scope
  requiredForRoles String[]            // Role IDs that require MFA
  exemptUsers      String[]            // User IDs exempt from MFA

  // Grace period
  gracePeriodDays  Int                 @default(7) // Days before enforcement
  gracePeriodStart DateTime?

  // Allowed methods
  allowedMethods   MfaMethod[]         @default([TOTP])

  // Settings
  rememberDeviceDays Int               @default(30)
  maxBackupCodes     Int               @default(10)

  // Notification
  notifyOnEnforcement Boolean          @default(true)

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([enforcementLevel])
  @@map("mfa_enforcements")
}

enum MfaEnforcementLevel {
  OPTIONAL        // User choice
  RECOMMENDED     // Prompted but not required
  REQUIRED_ADMIN  // Required for admin roles
  REQUIRED_PHI    // Required for PHI access
  REQUIRED_ALL    // Required for all users
}

// SecurityHeaderConfig - Security header configuration
model SecurityHeaderConfig {
  id               String          @id @default(cuid())
  organizationId   String          @unique

  // CORS
  corsEnabled      Boolean         @default(true)
  corsOrigins      String[]        @default(["*"])
  corsMethods      String[]        @default(["GET", "POST", "PUT", "DELETE"])
  corsHeaders      String[]        @default(["Content-Type", "Authorization"])

  // CSP
  cspEnabled       Boolean         @default(true)
  cspDirectives    Json?

  // Other headers
  hstsEnabled      Boolean         @default(true)
  hstsMaxAge       Int             @default(31536000) // 1 year
  xFrameOptions    String          @default("DENY")
  xContentTypeOptions Boolean      @default(true)
  referrerPolicy   String          @default("strict-origin-when-cross-origin")

  // Rate limiting
  rateLimitEnabled Boolean         @default(true)
  rateLimitWindow  Int             @default(60) // seconds
  rateLimitMax     Int             @default(100) // requests per window

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("security_header_configs")
}

// FeatureGateConfig - Feature gate rollout management
model FeatureGateConfig {
  id               String              @id @default(cuid())
  organizationId   String?             // null = global
  featureKey       String

  // Rollout config
  rolloutStage     RolloutStage        @default(DISABLED)
  rolloutPercentage Int                @default(0) // 0-100

  // Targeting
  targetEnvironments String[]          @default(["production"])
  targetRoles        String[]          // Roles that get the feature
  targetUsers        String[]          // Specific user IDs

  // Scheduling
  enabledAt        DateTime?
  disabledAt       DateTime?

  // Metrics
  impressions      Int                 @default(0)
  conversions      Int                 @default(0)

  // Notes
  description      String?
  changeLog        Json?               // Array of changes

  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([organizationId, featureKey])
  @@index([featureKey])
  @@index([rolloutStage])
  @@map("feature_gate_configs")
}

enum RolloutStage {
  DISABLED
  INTERNAL        // Internal testing only
  ALPHA           // Limited alpha users
  BETA            // Beta users
  PERCENTAGE      // Percentage rollout
  ENABLED         // Fully enabled
}

