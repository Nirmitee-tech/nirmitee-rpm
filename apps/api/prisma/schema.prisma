enum InventoryStatus {
  IN_STOCK
  ASSIGNED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  IN_USE
  RETURNED
  QUARANTINE
  DAMAGED
  DECOMMISSIONED
  LOST
