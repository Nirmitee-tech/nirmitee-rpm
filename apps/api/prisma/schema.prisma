// ============================================
// RPM - BILLING
// ============================================

model BillingRecord {
  id                   String        @id @default(cuid())
  patientId            String
  organizationId       String
  periodStart          DateTime
  periodEnd            DateTime
  dataTransmissionDays Int           @default(0)
  interactionMinutes   Int           @default(0)
  status               BillingStatus @default(PENDING)
  claimId              String?
  claimSubmittedAt     DateTime?
  paidAt               DateTime?
  amount               Float?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relations
  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  activities BillableActivity[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([organizationId, periodStart])
  @@map("billing_records")
}

model TimeLog {
  id              String      @id @default(cuid())
  patientId       String
  organizationId  String // Required for multi-tenant RLS
  userId          String // Clinical staff who logged the time
  startTime       DateTime
  endTime         DateTime?
  durationSeconds Int? // Calculated duration in seconds
  type            TimeLogType @default(INTERACTION) // Type of activity
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

