// Prisma schema for NirmiteeRPM
// Production-grade RBAC with multi-tenancy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORGANIZATION (Multi-tenancy)
// ============================================

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  settings  Json?     @default("{}")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  members       OrganizationMember[]
  teams         Team[]
  roles         Role[]
  invitations   Invitation[]
  authProviders AuthProvider[]
  subscription  Subscription?
  files         File[]
  apiKeys       ApiKey[]

  // Master Data Relations
  medicalConditions  MedicalCondition[]
  insuranceProviders InsuranceProvider[]
  externalProviders  ExternalProvider[]
  medications        Medication[]
  procedures         Procedure[]
  facilities         Facility[]
  deviceModels       DeviceModel[]

  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
  @@map("organization_members")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MfaMethod {
  TOTP // Authenticator app
  EMAIL // Email OTP
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // Optional for OAuth-only users
  firstName     String
  lastName      String
  avatar        String?
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  isSuperAdmin  Boolean   @default(false) // Platform super admin (not tenant-specific)
  deletedAt     DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // MFA (Multi-Factor Authentication)
  mfaEnabled     Boolean    @default(false)
  mfaMethod      MfaMethod? // TOTP or EMAIL
  mfaSecret      String? // TOTP secret (encrypted)
  mfaBackupCodes String[] // Hashed backup codes
  mfaEnabledAt   DateTime?

  // Email OTP
  emailOtpCode      String? // Current OTP code (hashed)
  emailOtpExpiresAt DateTime? // OTP expiration time

  // Phase 4: SMS notifications
  phoneNumber   String? // Phone for SMS notifications
  phoneVerified Boolean @default(false) // Whether phone is verified

  // Relations
  organizations          OrganizationMember[]
  teamMembers            TeamMember[]
  sessions               Session[]
  passwordResets         PasswordReset[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  authProviders          UserAuthProvider[]

  // RPM Relations
  patient                    Patient?
  caregiver                  Caregiver?
  patientsAsPrimaryPhysician Patient[]             @relation("PrimaryPhysician")
  patientsAsAssignedStaff    Patient[]             @relation("AssignedClinicalStaff")
  alertsAssigned             Alert[]               @relation("AlertAssignedTo")
  alertsEscalated            Alert[]               @relation("AlertEscalatedTo")
  alertsAcknowledged         Alert[]               @relation("AlertAcknowledgedBy")
  carePlansCreated           CarePlan[]            @relation("CarePlanCreatedBy")
  carePlansApproved          CarePlan[]            @relation("CarePlanApprovedBy")
  billableActivities         BillableActivity[]
  uploadedFiles              File[]
  dataExportRequests         DataExportRequest[]
  dataDeletionRequests       DataDeletionRequest[]
  consentRecords             ConsentRecord[]
  enrollmentDrafts           EnrollmentDraft[]
  timeLogsCreated            TimeLog[]             @relation("TimeLogUser")
  assessmentsCompleted       Assessment[]          @relation("AssessmentCompletedBy")

  // Phase 4: Escalation & Notification relations
  escalationsFrom            AlertEscalation[]     @relation("EscalationFrom")
  escalationsTo              AlertEscalation[]     @relation("EscalationTo")
  patientThresholdsCreated   PatientVitalThreshold[] @relation("PatientThresholdCreatedBy")
  alertNotificationLogs      AlertNotificationLog[]
  alertRulesCreated          AlertRule[]           @relation("AlertRuleCreatedBy")

  // Phase 5: Telehealth sessions as provider
  telehealthSessionsAsProvider TelehealthSession[] @relation("TelehealthProvider")

  @@index([email])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ============================================
// OAUTH PROVIDERS (Extensible SSO)
// ============================================

model AuthProvider {
  id             String            @id @default(cuid())
  organizationId String? // null = global, otherwise org-specific
  provider       OAuthProviderType
  name           String // Display name (e.g., "Google Workspace", "Microsoft Entra ID")
  clientId       String
  clientSecret   String // Encrypted in production
  tenantId       String? // For Microsoft/Azure AD
  domain         String? // For Google Workspace domain restriction
  scopes         String[]          @default(["openid", "email", "profile"])
  enabled        Boolean           @default(true)
  autoProvision  Boolean           @default(false) // Auto-create users on first login
  defaultRoleId  String? // Role to assign to auto-provisioned users
  settings       Json?             @default("{}") // Provider-specific settings
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultRole  Role?              @relation(fields: [defaultRoleId], references: [id])
  userAccounts UserAuthProvider[]

  @@unique([organizationId, provider])
  @@index([provider])
  @@index([enabled])
  @@map("auth_providers")
}

model UserAuthProvider {
  id             String    @id @default(cuid())
  userId         String
  providerId     String
  providerUserId String // External user ID from OAuth provider
  email          String // Email from OAuth provider
  accessToken    String? // OAuth access token (encrypted)
  refreshToken   String? // OAuth refresh token (encrypted)
  tokenExpiresAt DateTime?
  profile        Json? // Raw profile data from provider
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AuthProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerUserId])
  @@unique([userId, providerId])
  @@index([userId])
  @@index([email])
  @@map("user_auth_providers")
}

enum OAuthProviderType {
  GOOGLE
  MICROSOFT
  GITHUB
  OKTA
  AUTH0
  SAML // For future SAML/SSO support
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  organizationId String
  roleId         String
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String?
  createdAt      DateTime         @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============================================
// TEAM MANAGEMENT
// ============================================

model Team {
  id             String    @id @default(cuid())
  name           String
  description    String?
  organizationId String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

enum TeamRole {
  LEAD
  MEMBER
}

// ============================================
// RBAC - Role Based Access Control
// ============================================

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String? // null = system role, not null = custom org role
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization  Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  members       OrganizationMember[]
  invitations   Invitation[]
  authProviders AuthProvider[] // Default role for OAuth auto-provisioned users

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "users:read", "teams:write", "dashboard:view"
  name        String
  description String?
  module      String // e.g., "users", "teams", "dashboard", "reports"
  action      String // e.g., "read", "write", "delete", "manage"
  createdAt   DateTime @default(now())

  // Relations
  roles RolePermission[]

  @@index([module])
  @@index([action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// AUDIT LOG (for production tracking)
// ============================================

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String // e.g., "user.created", "role.updated"
  entity         String // e.g., "user", "role", "team"
  entityId       String?
  oldValues      Json? // Previous state for updates
  newValues      Json? // New state for creates/updates
  metadata       Json? // Additional context
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ============================================
// ACTIVITY FEED (User-friendly timeline)
// ============================================

model Activity {
  id             String    @id @default(cuid())
  organizationId String
  actorId        String // User who performed the action
  actorType      ActorType @default(USER)
  action         String // e.g., "created", "updated", "deleted"
  entityType     String // e.g., "user", "team", "patient", "alert"
  entityId       String
  entityName     String? // For display: "John Doe", "Team Alpha"
  metadata       Json? // Additional context
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([actorId, createdAt])
  @@index([organizationId, entityType, createdAt])
  @@map("activities")
}

enum ActorType {
  USER
  SYSTEM
  API
}

// ============================================
// NOTIFICATIONS (Real-time)
// ============================================

model Notification {
  id             String           @id @default(cuid())
  userId         String
  organizationId String?
  type           NotificationType
  title          String
  message        String
  data           Json? // Additional data for the notification
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  TEAM_INVITE
  ROLE_CHANGE
  USER_ADDED
  USER_REMOVED
  SYSTEM
  ALERT_CRITICAL
  ALERT_SIGNIFICANT
  CARE_PLAN_UPDATED
}

// ============================================
// NOTIFICATION PREFERENCES
// ============================================

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification channels
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)
  inAppEnabled Boolean @default(true)

  // Phase 4: SMS notifications
  smsEnabled         Boolean @default(false) // SMS channel enabled
  smsForCriticalOnly Boolean @default(true) // Only send SMS for critical alerts

  // Notification types
  securityAlerts  Boolean @default(true)
  teamUpdates     Boolean @default(true)
  systemUpdates   Boolean @default(true)
  marketingEmails Boolean @default(false)
  weeklyDigest    Boolean @default(true)

  // Phase 4: Alert notifications
  alertEmailEnabled Boolean @default(true) // Receive alert emails
  alertSmsEnabled   Boolean @default(false) // Receive alert SMS

  // Phase 4: Digest settings
  digestEnabled   Boolean         @default(false) // Enable digest emails
  digestFrequency DigestFrequency @default(DAILY) // DAILY or WEEKLY
  digestTime      String          @default("08:00") // Time to send digest

  // Quiet hours
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String? // "22:00"
  quietHoursEnd     String? // "08:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notification_preferences")
}

// ============================================
// MASTER DATA - Dynamic Configuration
// ============================================

model MedicalCondition {
  id             String   @id @default(cuid())
  organizationId String
  code           String // e.g., "HTN", "DM", "COPD"
  name           String // Display name
  description    String?
  category       String? // e.g., "Cardiovascular", "Respiratory"
  icdCode        String? // ICD-10 code for billing
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@index([category])
  @@map("medical_conditions")
}

model InsuranceProvider {
  id             String   @id @default(cuid())
  organizationId String
  code           String // e.g., "BCBS", "AETNA"
  name           String
  payerId        String? // Payer ID for claims
  phone          String?
  website        String?
  address        Json? // { street, city, state, zip }
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@map("insurance_providers")
}

// External Provider (not system users) - Referring physicians, specialists, etc.
model ExternalProvider {
  id             String   @id @default(cuid())
  organizationId String
  npiNumber      String // National Provider Identifier (10 digits)
  name           String // Full name / Practice name
  firstName      String?
  lastName       String?
  credentials    String? // e.g., "MD", "DO", "NP", "PA"
  specialty      String? // e.g., "Cardiology", "Internal Medicine"
  taxonomyCode   String? // Healthcare Provider Taxonomy Code
  practiceName   String? // Practice/Group name
  licenseNumber  String?
  licenseState   String?
  deaNumber      String? // DEA registration number
  phone          String?
  fax            String?
  email          String?
  address        Json? // { street, city, state, zip }
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, npiNumber])
  @@index([organizationId])
  @@index([isActive])
  @@index([specialty])
  @@map("external_providers")
}

model Medication {
  id             String   @id @default(cuid())
  organizationId String
  code           String // Internal code
  name           String // Display name (brand or generic)
  genericName    String?
  brandNames     String[] // Array of brand names
  dosageForm     String? // e.g., "Tablet", "Capsule", "Injection"
  strength       String? // e.g., "10mg", "500mg"
  ndc            String? // National Drug Code
  rxcui          String? // RxNorm Concept Unique Identifier
  category       String? // e.g., "Antihypertensive", "Antidiabetic"
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@index([category])
  @@map("medications")
}

model Procedure {
  id             String   @id @default(cuid())
  organizationId String
  code           String // Internal code
  name           String
  cptCode        String? // CPT code for billing
  hcpcsCode      String? // HCPCS code
  description    String?
  category       String? // e.g., "RPM Setup", "Monitoring", "Consultation"
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@index([category])
  @@map("procedures")
}

model Facility {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String? // e.g., "Hospital", "Clinic", "Lab", "Pharmacy"
  npi            String? // Facility NPI
  phone          String?
  fax            String?
  email          String?
  address        Json? // { street, city, state, zip }
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@index([type])
  @@map("facilities")
}

model DeviceModel {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  manufacturer   String?
  modelNumber    String?
  category       String? // e.g., "Blood Pressure", "Glucose", "Weight", "Pulse Oximeter"
  description    String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@index([category])
  @@map("device_models")
}

// ============================================
// RPM - PATIENT MANAGEMENT
// ============================================

model Patient {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  dateOfBirth    DateTime
  phone          String?
  address        Json? // { street, city, state, zip, country }
  conditions     String[] // Condition codes from MedicalCondition master data

  // Insurance information
  insuranceProviderId  String? // Insurance provider identifier
  insurancePlanName    String? // Plan name
  insuranceMemberId    String? // Member/policy ID
  insuranceGroupNumber String? // Group number (optional)

  enrollmentStatus        EnrollmentStatus @default(PENDING)
  enrollmentDate          DateTime? // Date of enrollment (for CPT 99453 billing)
  consentDate             DateTime? // Date patient consented to RPM
  primaryPhysicianId      String? // User ID of physician
  assignedClinicalStaffId String? // User ID of clinical staff
  deletedAt               DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  // Relations
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryPhysician User?           @relation("PrimaryPhysician", fields: [primaryPhysicianId], references: [id])
  clinicalStaff    User?           @relation("AssignedClinicalStaff", fields: [assignedClinicalStaffId], references: [id])
  devices          Device[]
  vitalReadings    VitalReading[]
  alerts           Alert[]
  carePlans        CarePlan[]
  caregiverLinks   CaregiverLink[]
  billingRecords   BillingRecord[]
  timeLogs         TimeLog[]
  assessments      Assessment[]

  // Phase 4: Patient-specific thresholds
  vitalThresholds  PatientVitalThreshold[]

  // Phase 5: Telehealth sessions
  telehealthSessions TelehealthSession[]

  // Health Records
  medications           PatientMedication[]
  allergies             PatientAllergy[]
  immunizations         Immunization[]
  labResults            LabResult[]
  medicalHistory        MedicalHistoryItem[]
  medicationAdherence   MedicationAdherence[]

  // Engagement
  engagement            PatientEngagement?
  goals                 PatientGoal[]
  achievements          PatientAchievement[]

  // Messaging
  conversations Conversation[]

  @@index([organizationId])
  @@index([userId])
  @@index([enrollmentStatus])
  @@index([deletedAt])
  @@index([primaryPhysicianId])
  @@index([assignedClinicalStaffId])
  @@index([organizationId, enrollmentStatus])
  @@map("patients")
}

model Caregiver {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  phone          String?
  relationship   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientLinks CaregiverLink[]

  @@index([organizationId])
  @@index([userId])
  @@map("caregivers")
}

model CaregiverLink {
  id               String               @id @default(cuid())
  patientId        String
  caregiverId      String
  organizationId   String // Required for multi-tenant RLS
  relationshipType RelationshipType
  accessLevel      CaregiverAccessLevel @default(VIEW_VITALS)
  status           CaregiverLinkStatus  @default(PENDING)
  consentGrantedAt DateTime?
  consentRevokedAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Relations
  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiver   Caregiver            @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  consents    CaregiverConsent[]
  delegations CaregiverDelegation[]

  @@unique([patientId, caregiverId])
  @@index([patientId])
  @@index([caregiverId])
  @@index([organizationId])
  @@index([status])
  @@map("caregiver_links")
}

enum PatientCondition {
  HYPERTENSION
  CONGESTIVE_HEART_FAILURE
  DIABETES_TYPE_1
  DIABETES_TYPE_2
  COPD
  CHRONIC_KIDNEY_DISEASE
  ARRHYTHMIA
  PRE_DIABETES
  OBESITY
  ASTHMA
  POST_COVID
  POST_SURGICAL
  OTHER
}

enum EnrollmentStatus {
  PENDING
  CONSENTED
  DEVICE_PENDING
  ACTIVE
  PAUSED
  DISCHARGED
}

enum RelationshipType {
  SPOUSE_PARTNER
  ADULT_CHILD
  PARENT
  SIBLING
  PROFESSIONAL_CAREGIVER
  LEGAL_GUARDIAN
  OTHER
}

enum CaregiverAccessLevel {
  VIEW_VITALS
  VIEW_ALERTS
  VIEW_CARE_PLAN
  FULL_ACCESS
}

enum CaregiverLinkStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

// ============================================
// RPM - DEVICE MANAGEMENT
// ============================================

model Device {
  id             String       @id @default(cuid())
  patientId      String
  organizationId String
  type           DeviceType
  serialNumber   String
  manufacturer   String?
  model          String?
  status         DeviceStatus @default(ACTIVE)
  lastSyncAt     DateTime?
  assignedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vitalReadings VitalReading[]
  pairings      DevicePairing[]
  telemetry     DeviceTelemetry[]

  @@unique([serialNumber])
  @@index([patientId])
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([organizationId, patientId])
  @@map("devices")
}

enum DeviceType {
  BLOOD_PRESSURE_MONITOR
  WEIGHT_SCALE
  PULSE_OXIMETER
  GLUCOSE_MONITOR
  CONTINUOUS_GLUCOSE_MONITOR
  THERMOMETER
  ACTIVITY_TRACKER
  ECG_MONITOR
  OTHER
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MALFUNCTIONING
  DECOMMISSIONED
}

// ============================================
// RPM - VITAL READINGS
// ============================================

model VitalReading {
  id             String     @id @default(cuid())
  patientId      String
  organizationId String
  deviceId       String?
  type           VitalType
  values         Json // e.g., { systolic: 140, diastolic: 90, pulse: 72 }
  unit           String
  source         DataSource @default(DEVICE)
  recordedAt     DateTime // When the reading was taken
  receivedAt     DateTime   @default(now()) // When system received it
  notes          String?
  createdAt      DateTime   @default(now())

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  device  Device? @relation(fields: [deviceId], references: [id])
  alerts  Alert[]

  @@index([patientId])
  @@index([organizationId])
  @@index([type])
  @@index([recordedAt])
  @@index([deviceId])
  @@index([patientId, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([patientId, type, recordedAt])
  @@map("vital_readings")
}

enum VitalType {
  BLOOD_PRESSURE
  WEIGHT
  BLOOD_GLUCOSE
  PULSE_OXIMETRY
  HEART_RATE
  TEMPERATURE
  RESPIRATORY_RATE
  BMI
}

enum DataSource {
  DEVICE
  MANUAL
  EHR_IMPORT
  CAREGIVER_ENTRY
}

// ============================================
// RPM - ALERTS
// ============================================

model Alert {
  id               String        @id @default(cuid())
  patientId        String
  organizationId   String
  vitalReadingId   String?
  type             AlertType
  severity         AlertSeverity
  status           AlertStatus   @default(NEW)
  message          String
  metadata         Json? // Additional context
  assignedToId     String? // Clinical staff
  escalatedToId    String? // Physician
  acknowledgedAt   DateTime?
  acknowledgedById String?
  escalatedAt      DateTime?
  resolvedAt       DateTime?
  resolution       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Phase 4: Escalation tracking
  escalationLevel    Int       @default(0) // 0 = initial, 1+ = escalated
  nextEscalationAt   DateTime? // When next escalation should happen
  escalationRuleId   String? // Rule governing this alert's escalation

  // Relations
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vitalReading     VitalReading? @relation(fields: [vitalReadingId], references: [id])
  assignedTo       User?         @relation("AlertAssignedTo", fields: [assignedToId], references: [id])
  escalatedTo      User?         @relation("AlertEscalatedTo", fields: [escalatedToId], references: [id])
  acknowledgedBy   User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  escalationRule   EscalationRule? @relation(fields: [escalationRuleId], references: [id])
  escalations      AlertEscalation[]
  notificationLogs AlertNotificationLog[]
  scores           AlertScore[]
  deduplication    AlertDeduplication?

  @@index([patientId])
  @@index([organizationId])
  @@index([severity])
  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([escalatedToId])
  @@index([createdAt])
  @@index([organizationId, status])
  @@index([patientId, status])
  @@index([assignedToId, status])
  @@index([escalationRuleId])
  @@index([nextEscalationAt])
  @@map("alerts")
}

enum AlertType {
  THRESHOLD_EXCEEDED
  TREND_CONCERNING
  ADHERENCE_LOW
  DEVICE_MALFUNCTION
  MISSED_READING
  CRITICAL_VALUE
  SYSTEM_GENERATED
}

enum AlertSeverity {
  CRITICAL
  SIGNIFICANT
  INFORMATIONAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
  DISMISSED
}

// ============================================
// RPM - CARE PLANS
