enum TimeLogType {
  INTERACTION // Direct patient interaction (calls, messages)
  MONITORING // Reviewing vitals, alerts
  DOCUMENTATION // Chart review, notes
  CARE_PLANNING // Care plan development
}

model BillableActivity {
  id              String   @id @default(cuid())
  billingRecordId String
  organizationId  String // Required for multi-tenant RLS
  cptCode         CPTCode
  performedById   String // User who performed activity
  performedAt     DateTime
  durationMinutes Int? // For time-based codes
  description     String?
  metadata        Json?
  createdAt       DateTime @default(now())

  // Relations
  billingRecord BillingRecord @relation(fields: [billingRecordId], references: [id], onDelete: Cascade)
  performedBy   User          @relation(fields: [performedById], references: [id])

  @@index([billingRecordId])
  @@index([organizationId])
  @@index([cptCode])
  @@index([performedById])
  @@index([performedAt])
  @@map("billable_activities")
}

enum CPTCode {
  CPT_99453 // Initial setup & patient education
  CPT_99445 // Device supply 2-15 days (NEW 2026)
  CPT_99454 // Device supply 16+ days
  CPT_99470 // Treatment management 10 min real-time (NEW 2026)
  CPT_99457 // Treatment management 20-39 min
  CPT_99458 // Additional management 20 min
}

enum BillingStatus {
  PENDING
  ELIGIBLE
  SUBMITTED
  ACCEPTED
  DENIED
  PAID
  APPEALED
}

// ============================================
// SUBSCRIPTION & BILLING (Stripe)
// ============================================

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([stripeCustomerId])
  @@index([status])
  @@index([organizationId])
  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(cuid())
  subscriptionId  String
  organizationId  String // Denormalized for multi-tenant queries
  stripeInvoiceId String        @unique
  amount          Int // Amount in cents
  currency        String        @default("usd")
  status          InvoiceStatus
  paidAt          DateTime?
  invoiceUrl      String?
  invoicePdf      String?
  createdAt       DateTime      @default(now())

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model PricingPlan {
  id            String          @id @default(cuid())
  name          String
  description   String?
  stripePriceId String          @unique
  amount        Int // Amount in cents
  currency      String          @default("usd")
  interval      BillingInterval
  features      Json // Array of feature strings
  limits        Json // { users: 10, storage: "5GB", patients: 100 }
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("pricing_plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingInterval {
  MONTH
  YEAR
}

// ============================================
// FILE STORAGE
// ============================================

model File {
  id             String    @id @default(cuid())
  organizationId String
  uploadedBy     String
  key            String    @unique
  filename       String
  contentType    String
  size           Int
  metadata       Json?     @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([uploadedBy])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("files")
}

// ============================================
// FEATURE FLAGS
// ============================================

model FeatureFlag {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  description String?
  enabled     Boolean           @default(false)
  targetType  FeatureFlagTarget @default(GLOBAL)
  targetIds   String[] // organizationIds or userIds
  percentage  Int? // For gradual rollout (0-100)
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([key])
  @@index([enabled])
  @@map("feature_flags")
}

enum FeatureFlagTarget {
  GLOBAL // All users
  ORGANIZATION // Specific orgs
  USER // Specific users
  PERCENTAGE // Random percentage
}

// ============================================
// API KEY MANAGEMENT
// ============================================

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String // Descriptive name (e.g., "Production API", "Mobile App")
  keyHash        String    @unique // Hashed API key for security
  keyPrefix      String // First 8 chars for identification (e.g., "pk_live_")
  permissions    String[] // Allowed scopes (e.g., ["read:users", "write:patients"])
  lastUsedAt     DateTime?
  expiresAt      DateTime? // Optional expiration
  isActive       Boolean   @default(true)
  metadata       Json?     @default("{}") // Additional context
  createdAt      DateTime  @default(now())
  createdBy      String
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
  @@index([isActive])
  @@index([expiresAt])
  @@index([organizationId, isActive])
  @@map("api_keys")
}

// ============================================
// BACKUP & DISASTER RECOVERY
// ============================================

model Backup {
  id          String       @id @default(cuid())
  type        BackupType
  status      BackupStatus @default(PENDING)
  size        BigInt?
  location    String? // S3 path or local path
  metadata    Json?
  error       String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdBy   String?

  @@index([status])
  @@index([type])
  @@index([startedAt])
  @@map("backups")
}

enum BackupType {
  DATABASE
  FILES
  FULL
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  VERIFIED
}

// ============================================
// GDPR & PRIVACY COMPLIANCE
// ============================================

model DataExportRequest {
  id           String           @id @default(cuid())
  userId       String
  status       DataExportStatus @default(PENDING)
  format       String           @default("JSON") // JSON, ZIP
  fileLocation String?
  expiresAt    DateTime?
  completedAt  DateTime?
  error        String?
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("data_export_requests")
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model DataDeletionRequest {
  id           String             @id @default(cuid())
  userId       String
  status       DataDeletionStatus @default(PENDING)
  reason       String?
  scheduledFor DateTime
  completedAt  DateTime?
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
  @@index([createdAt])
  @@map("data_deletion_requests")
}

enum DataDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String
  consentType ConsentType
  granted     Boolean
  grantedAt   DateTime?
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@index([userId])
  @@index([consentType])
  @@index([granted])
  @@map("consent_records")
}

enum ConsentType {
  ESSENTIAL
  ANALYTICS
  MARKETING
  THIRD_PARTY
}

// ============================================
// ENROLLMENT DRAFT MANAGEMENT
// ============================================

model EnrollmentDraft {
  id             String    @id @default(cuid())
  userId         String // User creating the draft
  organizationId String // Required for multi-tenant RLS
  step           Int       @default(1) // Current step in enrollment wizard
  data           Json // Partial enrollment data
  expiresAt      DateTime? // Optional expiration
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([userId, organizationId])
  @@index([expiresAt])
  @@map("enrollment_drafts")
}

// ============================================
// PHASE 4: MONITORING & ALERTS
// ============================================

// VitalThreshold - Organization-level default thresholds
model VitalThreshold {
  id             String    @id @default(cuid())
  organizationId String
  vitalType      VitalType

  // Warning thresholds
  warningMin Float?
  warningMax Float?

  // Critical thresholds
  criticalMin Float?
  criticalMax Float?

  // Secondary thresholds (for BP diastolic)
  warningMinSecondary  Float?
  warningMaxSecondary  Float?
  criticalMinSecondary Float?
  criticalMaxSecondary Float?

  // Metadata
  unit      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, vitalType])
  @@index([organizationId])
  @@index([vitalType])
  @@index([isActive])
  @@map("vital_thresholds")
}

// PatientVitalThreshold - Per-patient threshold overrides
model PatientVitalThreshold {
  id             String    @id @default(cuid())
  patientId      String
  organizationId String // Required for multi-tenant RLS
  vitalType      VitalType

  // Warning thresholds
  warningMin Float?
  warningMax Float?

  // Critical thresholds
  criticalMin Float?
  criticalMax Float?

  // Secondary thresholds (for BP diastolic)
  warningMinSecondary  Float?
  warningMaxSecondary  Float?
  criticalMinSecondary Float?
  criticalMaxSecondary Float?

  // Override settings
  useCustomThresholds Boolean @default(true)
  notes               String? // Clinical justification

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String? // Clinician who set it

  // Relations
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PatientThresholdCreatedBy", fields: [createdById], references: [id])

  @@unique([patientId, vitalType])
  @@index([organizationId])
  @@index([patientId])
  @@index([vitalType])
  @@map("patient_vital_thresholds")
}

// EscalationRule - Workflow rules for alert escalation
model EscalationRule {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?

  // Trigger conditions
  severity   AlertSeverity // CRITICAL, SIGNIFICANT, INFORMATIONAL
  vitalTypes VitalType[] // Which vital types this rule applies to

  // Escalation chain: [{level, roleType, delayMinutes}]
  escalationChain Json

  // Settings
  isActive   Boolean @default(true)
  autoAssign Boolean @default(true) // Auto-assign to care team
  priority   Int     @default(0) // Higher = evaluated first

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  alerts Alert[]

  @@index([organizationId])
  @@index([severity])
  @@index([isActive])
  @@index([priority])
  @@map("escalation_rules")
}

// AlertEscalation - Audit trail for escalation actions
model AlertEscalation {
  id             String   @id @default(cuid())
  alertId        String
  organizationId String // Required for multi-tenant RLS

  // Escalation details
  fromLevel  Int // 0 = initial, 1 = first escalation, etc.
  toLevel    Int
  fromUserId String? // Previous assignee
  toUserId   String // New assignee

  // Timing
  scheduledAt DateTime? // When escalation was scheduled
  executedAt  DateTime  @default(now()) // When it happened

  // Reason
  reason EscalationReason
  notes  String?

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  alert    Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  fromUser User? @relation("EscalationFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("EscalationTo", fields: [toUserId], references: [id])

  @@index([alertId])
  @@index([organizationId])
  @@index([toUserId])
  @@index([fromUserId])
  @@index([createdAt])
  @@map("alert_escalations")
}

enum EscalationReason {
  TIME_EXCEEDED // Not acknowledged in time
  MANUAL_ESCALATION // Clinician manually escalated
  SEVERITY_UPGRADE // Condition worsened
  RULE_BASED // Automatic rule triggered
}

// AlertRule - Custom alert trigger rules
model AlertRule {
  id             String   @id @default(cuid())
  organizationId String

  // Rule info
  name        String
  description String?

  // Conditions: [{id, vital, operator, value}]
  conditions     Json // Array of condition objects
  conditionLogic AlertConditionLogic @default(AND)

  // Alert settings
  severity AlertSeverity
  actions  String[] // ['notification', 'email', 'sms', 'call']

  // Status
  isEnabled Boolean @default(true)

  // Stats (updated when triggered)
  triggeredCount Int       @default(0)
  lastTriggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String?

  // Relations
  createdBy User? @relation("AlertRuleCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([isEnabled])
  @@index([severity])
  @@map("alert_rules")
}

enum AlertConditionLogic {
  AND
  OR
}

// AlertNotificationLog - Track notification delivery
model AlertNotificationLog {
  id             String              @id @default(cuid())
  alertId        String
  organizationId String // Required for multi-tenant RLS
  userId         String
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  retryCount     Int                 @default(0)
  externalId     String? // Twilio SID or email message ID
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("alert_notification_logs")
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  PUSH
}

enum DeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum DigestFrequency {
  DAILY
  WEEKLY
}

// ============================================
// TELEHEALTH - VIDEO CONSULTATIONS
// ============================================

model TelehealthSession {
  id             String                 @id @default(cuid())
  organizationId String // Required for multi-tenant RLS
  patientId      String
  providerId     String

  // 100ms Room Info
  roomId   String // 100ms room ID
  roomCode String // Room code for joining

  // Session Status
  status TelehealthSessionStatus @default(SCHEDULED)

  // Timing
  scheduledAt     DateTime  @default(now())
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int? // Duration in seconds
  billableMinutes Int? // Rounded up minutes for billing

  // Metadata
  metadata  Json? // Additional session info
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patient  Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider User    @relation("TelehealthProvider", fields: [providerId], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("telehealth_sessions")
}

enum TelehealthSessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============================================
// PATIENT HEALTH RECORDS
// ============================================

// PatientMedication - Medications prescribed to a patient
model PatientMedication {
  id             String                   @id @default(cuid())
  patientId      String
  organizationId String // Required for multi-tenant RLS
  name           String // Medication name
  genericName    String?
  dosage         String // e.g., "10mg", "500mg"
  frequency      String // e.g., "Once daily", "Twice daily"
  route          String? // e.g., "Oral", "Injection", "Topical"
  prescribedBy   String? // Provider name
  prescribedDate DateTime?
  startDate      DateTime?
  endDate        DateTime?
  status         MedicationStatus         @default(ACTIVE)
  refillsRemaining Int?
  pharmacy       String?
  instructions   String? // Special instructions
  sideEffects    String? // Known side effects for this patient
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Relations
  patient        Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  adherenceLogs  MedicationAdherence[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, patientId])
  @@map("patient_medications")
}

enum MedicationStatus {
  ACTIVE
  DISCONTINUED
  ON_HOLD
  COMPLETED
}

// MedicationAdherence - Tracks when patients take their medications
model MedicationAdherence {
  id                  String           @id @default(cuid())
  patientMedicationId String
  organizationId      String           // Required for multi-tenant RLS
  patientId           String           // Denormalized for easier queries
  scheduledTime       DateTime         // When medication was supposed to be taken
  takenAt             DateTime?        // When actually taken (null if not taken)
  status              AdherenceStatus  @default(PENDING)
  notes               String?
  skippedReason       String?          // Reason if skipped
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relations
  patientMedication PatientMedication @relation(fields: [patientMedicationId], references: [id], onDelete: Cascade)
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientMedicationId])
  @@index([patientId])
  @@index([organizationId])
  @@index([scheduledTime])
  @@index([patientId, scheduledTime])
  @@map("medication_adherence")
}

enum AdherenceStatus {
  PENDING   // Not yet due or waiting
  TAKEN     // Taken on time or late
  MISSED    // Not taken within window
  SKIPPED   // Intentionally skipped
}

// ============================================
// PATIENT ENGAGEMENT (Streaks, Goals, Achievements)
// ============================================

// PatientEngagement - Track patient engagement metrics
model PatientEngagement {
  id               String   @id @default(cuid())
  patientId        String   @unique
  organizationId   String   // Required for multi-tenant RLS

  // Streak tracking
  currentStreak    Int      @default(0)  // Current consecutive days
  longestStreak    Int      @default(0)  // Best streak ever
  lastActiveDate   DateTime? // Last day patient recorded vitals

  // Weekly stats
  weekStartDate    DateTime? // Start of current week tracking
  weeklyReadings   Int       @default(0)  // Readings this week
  weeklyGoalTarget Int       @default(21) // Default: 3 readings/day * 7 days

  // Total stats
  totalReadings    Int      @default(0)
  totalPoints      Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([patientId])
  @@map("patient_engagement")
}

// PatientGoal - Individual goals for patients
model PatientGoal {
  id             String     @id @default(cuid())
  patientId      String
  organizationId String     // Required for multi-tenant RLS
  name           String     // e.g., "Blood Pressure Readings"
  description    String?
  goalType       GoalType   @default(VITALS)
  targetValue    Int        // Target count
  currentValue   Int        @default(0)
  unit           String     @default("readings") // e.g., "readings", "doses", "lessons"
  periodType     GoalPeriod @default(WEEKLY)
  periodStartDate DateTime? // When current period started
  isActive       Boolean    @default(true)
  completedAt    DateTime?  // When goal was achieved
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([organizationId])
  @@index([patientId, isActive])
  @@map("patient_goals")
}

enum GoalType {
  VITALS      // Recording vital signs
  MEDICATION  // Taking medications
  EDUCATION   // Completing lessons
  EXERCISE    // Physical activity
  CUSTOM      // Custom goals
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

// Achievement - Master list of achievements (org-specific or global)
model Achievement {
  id             String           @id @default(cuid())
  organizationId String?          // Null for global achievements
  code           String           // Unique code like "FIRST_READING", "STREAK_7"
  name           String
  description    String
  icon           String           @default("star") // star, trophy, flame, target
  category       AchievementCategory @default(MILESTONE)
  pointValue     Int              @default(50)

  // Requirements
  requirementType AchievementRequirement
  requirementValue Int            // e.g., 7 for STREAK_7

  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  patientAchievements PatientAchievement[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@map("achievements")
}

enum AchievementCategory {
  MILESTONE    // First time events
  STREAK       // Consecutive day achievements
  GOALS        // Goal completion
  MEDICATION   // Medication adherence
  EDUCATION    // Learning achievements
  HEALTH       // Health improvement
}

enum AchievementRequirement {
  FIRST_READING      // Record first vital
  STREAK_DAYS        // Maintain streak for N days
  WEEKLY_GOAL        // Complete weekly goal
  MEDICATION_STREAK  // Take all meds for N days
  LESSONS_COMPLETED  // Complete N lessons
  HEALTH_STATUS_DAYS // Maintain good status for N days
  TOTAL_READINGS     // Record N total readings
}

// PatientAchievement - Achievements earned by patients
model PatientAchievement {
  id             String   @id @default(cuid())
  patientId      String
  achievementId  String
  organizationId String   // Required for multi-tenant RLS
  earnedAt       DateTime @default(now())

  // Progress tracking for partially completed achievements
  currentProgress Int?    // Current progress value

  // Relations
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([patientId, achievementId])
  @@index([patientId])
  @@index([achievementId])
  @@index([organizationId])
  @@map("patient_achievements")
}

// PatientAllergy - Patient's allergies
model PatientAllergy {
  id             String         @id @default(cuid())
  patientId      String
  organizationId String // Required for multi-tenant RLS
  allergen       String // What the patient is allergic to
  type           AllergyType    @default(DRUG)
  severity       AllergySeverity @default(MODERATE)
  reaction       String? // Description of reaction
  onsetDate      DateTime?
  reportedBy     String? // Who reported this allergy
  verifiedBy     String? // Provider who verified
  verifiedDate   DateTime?
  status         AllergyStatus  @default(ACTIVE)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([organizationId, patientId])
  @@map("patient_allergies")
}

enum AllergyType {
  DRUG
  FOOD
  ENVIRONMENTAL
  LATEX
  INSECT
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  RESOLVED
}

// Immunization - Patient's immunization records
model Immunization {
  id               String            @id @default(cuid())
  patientId        String
  organizationId   String // Required for multi-tenant RLS
  vaccineName      String
  vaccineCode      String? // CVX code
  manufacturer     String?
  lotNumber        String?
  administeredDate DateTime
  expirationDate   DateTime?
  site             String? // Injection site
  route            String? // Administration route
  dosage           String?
  doseNumber       Int? // Which dose in series
  series           String? // e.g., "COVID-19 Primary Series"
  administeredBy   String? // Provider name
  location         String? // Where administered
  status           ImmunizationStatus @default(COMPLETED)
  reaction         String? // Any reaction noted
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([organizationId])
  @@index([vaccineName])
  @@index([administeredDate])
  @@index([organizationId, patientId])
  @@map("immunizations")
}

enum ImmunizationStatus {
  COMPLETED
  NOT_DONE
  ENTERED_IN_ERROR
}

// LabResult - Patient's lab test results
model LabResult {
  id             String       @id @default(cuid())
  patientId      String
  organizationId String // Required for multi-tenant RLS
  testName       String
  testCode       String? // LOINC code
  category       String? // e.g., "Chemistry", "Hematology"
  value          String // Test result value
  unit           String? // Unit of measurement
  referenceMin   String? // Reference range min
  referenceMax   String? // Reference range max
  referenceRange String? // Full reference range text
  status         LabResultStatus @default(FINAL)
  interpretation LabInterpretation? // NORMAL, ABNORMAL, CRITICAL
  collectedAt    DateTime? // When sample collected
  resultedAt     DateTime // When result was available
  orderedBy      String? // Provider who ordered
  performedBy    String? // Lab that performed test
  specimenType   String? // e.g., "Blood", "Urine"
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([organizationId])
  @@index([testName])
  @@index([category])
  @@index([resultedAt])
  @@index([interpretation])
  @@index([organizationId, patientId])
  @@map("lab_results")
}

enum LabResultStatus {
  REGISTERED
  PARTIAL
  PRELIMINARY
  FINAL
  AMENDED
  CORRECTED
  CANCELLED
}

enum LabInterpretation {
  NORMAL
  ABNORMAL
  CRITICAL
  HIGH
  LOW
}

// MedicalHistoryItem - Patient's medical history (conditions)
model MedicalHistoryItem {
  id             String                  @id @default(cuid())
  patientId      String
  organizationId String // Required for multi-tenant RLS
  condition      String // Condition name
  icdCode        String? // ICD-10 code
  diagnosedDate  DateTime?
  resolvedDate   DateTime?
  status         MedicalHistoryStatus    @default(ACTIVE)
  severity       String? // Mild, Moderate, Severe
  treatedBy      String? // Provider treating this condition
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([condition])
  @@index([organizationId, patientId])
  @@map("medical_history_items")
}

enum MedicalHistoryStatus {
  ACTIVE
  RESOLVED
  CHRONIC
  INACTIVE
}

// ============================================
// SECURE MESSAGING
// ============================================

// Conversation - Message thread between participants
model Conversation {
  id             String              @id @default(cuid())
  organizationId String // Required for multi-tenant RLS
  patientId      String // Patient in the conversation
  subject        String? // Optional subject line
  status         ConversationStatus  @default(ACTIVE)
  lastMessageAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  patient      Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]

  @@index([organizationId])
  @@index([patientId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([organizationId, patientId])
  @@map("conversations")
}

// ConversationParticipant - Users in a conversation
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  organizationId String // Required for multi-tenant RLS
  role           String // e.g., "provider", "patient", "care_manager"
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([organizationId])
  @@map("conversation_participants")
}

// Message - Individual message in a conversation
model Message {
  id             String        @id @default(cuid())
  conversationId String
  organizationId String // Required for multi-tenant RLS
  senderId       String // User who sent the message
  senderName     String // Cached sender name
  senderRole     String // Role of sender (provider, patient)
  content        String @db.Text // Message content
  messageType    MessageType   @default(TEXT)
  attachments    Json? // Array of attachment URLs
  isRead         Boolean       @default(false)
  readAt         DateTime?
  sentAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([organizationId])
  @@index([senderId])
  @@index([sentAt])
  @@index([conversationId, sentAt])
  @@map("messages")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum MessageType {
  TEXT
  ATTACHMENT
  SYSTEM
}

// ============================================
// DEVICE DATA INGESTION - Hub & Webhook System
// ============================================

// DeviceHub - Vendor/device hub connectors (e.g., iHealth, Bodytrace, Withings)
model DeviceHub {
  id             String          @id @default(cuid())
  organizationId String
  name           String          // e.g., "iHealth Cloud", "Withings API"
  vendor         String          // e.g., "iHealth", "Withings", "Bodytrace"
  type           DeviceHubType   @default(API)

  // Connection config
  apiEndpoint    String?         // Base API URL
  clientId       String?         // OAuth client ID
  clientSecret   String?         // OAuth client secret (encrypted)
  accessToken    String?         // Current access token (encrypted)
  refreshToken   String?         // Refresh token (encrypted)
  tokenExpiresAt DateTime?
  webhookUrl     String?         // Our webhook endpoint for this hub
  webhookSecret  String?         // Webhook signature secret

  // Status
  status         DeviceHubStatus @default(INACTIVE)
  lastSyncAt     DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  syncFrequency  Int             @default(15) // Minutes between syncs

  // Settings
  settings       Json?           @default("{}") // Hub-specific settings
  supportedTypes DeviceType[]    // Which device types this hub supports

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  devicePairings DevicePairing[]
  webhookLogs    DeviceWebhookLog[]
  telemetryData  DeviceTelemetry[]

  @@unique([organizationId, vendor])
  @@index([organizationId])
  @@index([status])
  @@index([vendor])
  @@map("device_hubs")
}

enum DeviceHubType {
  API           // REST API polling
  WEBHOOK       // Webhook push
  MQTT          // MQTT broker
  BLE_GATEWAY   // Bluetooth gateway
  MANUAL        // Manual data entry
}

enum DeviceHubStatus {
  ACTIVE
  INACTIVE
  ERROR
  CONFIGURING
  RATE_LIMITED
}

// DevicePairing - Links patient devices to vendor hub accounts
model DevicePairing {
  id               String             @id @default(cuid())
  deviceId         String
  hubId            String
  organizationId   String

  // Vendor identification
  vendorDeviceId   String             // Device ID in vendor's system
  vendorUserId     String?            // User ID in vendor's system

  // Pairing status
  status           PairingStatus      @default(PENDING)
  pairedAt         DateTime?
  pairingCode      String?            // QR/pairing code if needed
  pairingExpiresAt DateTime?

  // Sync tracking
  lastSyncAt       DateTime?
  lastDataAt       DateTime?          // Last data received
  syncEnabled      Boolean            @default(true)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  device           Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  hub              DeviceHub          @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@unique([deviceId, hubId])
  @@unique([hubId, vendorDeviceId])
  @@index([organizationId])
  @@index([status])
  @@index([hubId])
  @@map("device_pairings")
}

enum PairingStatus {
  PENDING
  PAIRED
  FAILED
  EXPIRED
  DISCONNECTED
}

// DeviceWebhookLog - Incoming webhook event tracking
model DeviceWebhookLog {
  id             String              @id @default(cuid())
  hubId          String
  organizationId String

  // Request info
  eventType      String              // e.g., "measurement.created", "device.synced"
  payload        Json                // Raw webhook payload
  headers        Json?               // Request headers
  signature      String?             // Webhook signature

  // Processing
  status         WebhookProcessStatus @default(RECEIVED)
  processedAt    DateTime?
  errorMessage   String?
  retryCount     Int                 @default(0)

  // Linked data
  deviceId       String?             // Parsed device ID
  vitalReadingId String?             // Created vital reading if any

  receivedAt     DateTime            @default(now())

  // Relations
  hub            DeviceHub           @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@index([hubId])
  @@index([organizationId])
  @@index([status])
  @@index([eventType])
  @@index([receivedAt])
  @@map("device_webhook_logs")
}

enum WebhookProcessStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  DUPLICATE
}

// DeviceTelemetry - Battery, signal, and device health data
model DeviceTelemetry {
  id             String          @id @default(cuid())
  deviceId       String
  hubId          String?
  organizationId String
  telemetryType  TelemetryType   @default(HEARTBEAT)

  // Battery
  batteryLevel   Int?            // 0-100 percentage
  batteryStatus  BatteryStatus?

  // Signal/Connectivity
  signalStrength Int?            // -100 to 0 dBm for cellular, 0-100 for WiFi
  signalType     String?         // "WiFi", "Cellular", "Bluetooth"
  isOnline       Boolean         @default(false)
  lastOnlineAt   DateTime?

  // Device health
  firmwareVersion String?
  errorCode       String?
  errorMessage    String?

  // Sync info
  lastMeasurementAt DateTime?
  measurementCount  Int          @default(0)

  recordedAt     DateTime        @default(now())

  // Relations
  device         Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  hub            DeviceHub?      @relation(fields: [hubId], references: [id])

  @@index([deviceId])
  @@index([organizationId])
  @@index([recordedAt])
  @@index([deviceId, recordedAt])
  @@map("device_telemetry")
}

enum BatteryStatus {
  FULL
  GOOD
  LOW
  CRITICAL
  CHARGING
  UNKNOWN
}

// DeviceFirmware - Firmware versions and lot tracking
model DeviceFirmware {
  id               String          @id @default(cuid())
  organizationId   String

  // Device model info
  manufacturer     String
  modelNumber      String

  // Firmware info
  version          String
  releaseDate      DateTime?
  releaseNotes     String?
  downloadUrl      String?
  fileSize         Int?            // bytes
  checksum         String?

  // Lot tracking
  lotNumber        String?
  manufacturedDate DateTime?
  expirationDate   DateTime?       // For consumable devices

  // Status
  isLatest         Boolean         @default(false)
  isRequired       Boolean         @default(false) // Required update
  minVersion       String?         // Minimum supported version

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([organizationId, manufacturer, modelNumber, version])
  @@index([organizationId])
  @@index([manufacturer, modelNumber])
  @@index([isLatest])
  @@map("device_firmware")
}

// ============================================
// CAREGIVER CONSENT & DELEGATION
// ============================================

// CaregiverConsent - Detailed consent records for caregiver access
model CaregiverConsent {
  id               String              @id @default(cuid())
  caregiverLinkId  String
  organizationId   String

  // Consent details
  consentType      CaregiverConsentType
  consentMethod    ConsentMethod       @default(DIGITAL)
  consentVersion   String              @default("1.0")

  // Scope of consent
  accessScope      String[]            // ["vitals", "alerts", "medications", "care_plan"]
  canDelegate      Boolean             @default(false) // Can caregiver delegate to others
  canCommunicate   Boolean             @default(true)  // Can message care team
  canSchedule      Boolean             @default(false) // Can schedule appointments

  // Validity
  grantedAt        DateTime            @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedReason    String?

  // Audit
  grantedById      String              // Patient who granted
  witnessedById    String?             // Staff who witnessed
  documentUrl      String?             // Signed consent document
  ipAddress        String?
  userAgent        String?

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  caregiverLink    CaregiverLink       @relation(fields: [caregiverLinkId], references: [id], onDelete: Cascade)

  @@index([caregiverLinkId])
  @@index([organizationId])
  @@index([consentType])
  @@index([grantedAt])
  @@map("caregiver_consents")
}

enum CaregiverConsentType {
  VIEW_ONLY
  FULL_ACCESS
  MEDICAL_PROXY
  HEALTHCARE_POWER_OF_ATTORNEY
  EMERGENCY_CONTACT
}

enum ConsentMethod {
  DIGITAL         // Signed digitally in app
  WET_SIGNATURE   // Physical signature scanned
  VERBAL          // Verbal consent documented
  LEGAL_DOCUMENT  // Legal document on file
}

// CaregiverDelegation - Actions delegated to caregivers
model CaregiverDelegation {
  id               String                @id @default(cuid())
  caregiverLinkId  String
  organizationId   String

  // Delegation details
  actionType       DelegatedActionType
  status           DelegationStatus      @default(PENDING)

  // Context
  entityType       String?               // "vital_reading", "appointment", etc.
  entityId         String?               // ID of the entity
  metadata         Json?                 // Additional context

  // Execution
  requestedAt      DateTime              @default(now())
  requestedById    String                // Patient who requested
  executedAt       DateTime?
  executedById     String?               // Caregiver who executed
  result           String?               // Result/notes

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // Relations
  caregiverLink    CaregiverLink         @relation(fields: [caregiverLinkId], references: [id], onDelete: Cascade)

  @@index([caregiverLinkId])
  @@index([organizationId])
  @@index([actionType])
  @@index([status])
  @@index([requestedAt])
  @@map("caregiver_delegations")
}

enum DelegatedActionType {
  RECORD_VITAL
  CONFIRM_MEDICATION
  SCHEDULE_APPOINTMENT
  MESSAGE_PROVIDER
  REQUEST_REFILL
  ACKNOWLEDGE_ALERT
  UPDATE_PROFILE
}

enum DelegationStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

// ============================================
// EHR/FHIR INTEGRATION
// ============================================

// FhirConnection - SMART on FHIR client configuration
model FhirConnection {
  id               String              @id @default(cuid())
  organizationId   String
  name             String              // e.g., "Epic MyChart", "Cerner"

  // FHIR Server Config
  fhirVersion      String              @default("R4") // DSTU2, STU3, R4
  baseUrl          String              // FHIR server base URL
  authType         FhirAuthType        @default(SMART_ON_FHIR)

  // OAuth/SMART credentials
  clientId         String?
  clientSecret     String?             // Encrypted
  scopes           String[]            @default(["patient/*.read", "user/*.read"])

  // Token management
  accessToken      String?             // Encrypted
  refreshToken     String?             // Encrypted
  tokenExpiresAt   DateTime?

  // Connection status
  status           FhirConnectionStatus @default(INACTIVE)
  lastConnectedAt  DateTime?
  lastErrorAt      DateTime?
  lastError        String?

  // Sync settings
  syncEnabled      Boolean             @default(false)
  syncDirection    FhirSyncDirection   @default(BIDIRECTIONAL)
  syncFrequency    Int                 @default(60) // Minutes
  lastSyncAt       DateTime?

  // Resource mapping
  patientIdMapping String?             // How to map our patient ID to FHIR

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  resourceMappings FhirResourceMapping[]
  syncLogs         FhirSyncLog[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([status])
  @@map("fhir_connections")
}

enum FhirAuthType {
  SMART_ON_FHIR
  OAUTH2
  BASIC
  API_KEY
}

enum FhirConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_AUTH
  EXPIRED
}

enum FhirSyncDirection {
  INBOUND       // EHR -> RPM
  OUTBOUND      // RPM -> EHR
  BIDIRECTIONAL // Both ways
}

// FhirResourceMapping - Maps FHIR resources to local entities
model FhirResourceMapping {
  id               String              @id @default(cuid())
  connectionId     String
  organizationId   String

  // FHIR resource type
  fhirResourceType FhirResourceType

  // Local entity mapping
  localEntityType  String              // "patient", "vital_reading", "care_plan", etc.

  // Field mappings (JSON: { fhirField: localField })
  fieldMappings    Json

  // Transformation rules
  valueTransforms  Json?               // e.g., unit conversions
  filterCriteria   Json?               // Which records to sync

  // Sync behavior
  enabled          Boolean             @default(true)
  direction        FhirSyncDirection   @default(BIDIRECTIONAL)
  priority         Int                 @default(0)

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  connection       FhirConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, fhirResourceType])
  @@index([organizationId])
  @@index([connectionId])
  @@index([fhirResourceType])
  @@map("fhir_resource_mappings")
}

enum FhirResourceType {
  PATIENT
  OBSERVATION
  CONDITION
  CAREPLAN
  MEDICATIONREQUEST
  ALLERGYINTOLERANCE
  IMMUNIZATION
  DIAGNOSTICREPORT
  ENCOUNTER
  PROCEDURE
  DEVICE
  GOAL
}

// FhirSyncLog - Integration health checks and sync history
model FhirSyncLog {
  id               String            @id @default(cuid())
  connectionId     String
  organizationId   String

  // Sync details
  syncType         FhirSyncType
  direction        FhirSyncDirection
  resourceType     FhirResourceType?

  // Results
  status           FhirSyncStatus    @default(IN_PROGRESS)
  recordsProcessed Int               @default(0)
  recordsCreated   Int               @default(0)
  recordsUpdated   Int               @default(0)
  recordsFailed    Int               @default(0)

  // Errors
  errorMessage     String?
  errorDetails     Json?

  // Timing
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  durationMs       Int?

  // Context
  triggeredBy      String?           // "scheduled", "manual", "webhook"
  metadata         Json?

  // Relations
  connection       FhirConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([organizationId])
  @@index([status])
  @@index([syncType])
  @@index([startedAt])
  @@map("fhir_sync_logs")
}

enum FhirSyncType {
  FULL_SYNC
  INCREMENTAL
  SINGLE_RESOURCE
  HEALTH_CHECK
}

enum FhirSyncStatus {
  IN_PROGRESS
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

// ============================================
// RCM/CLAIMS MANAGEMENT
// ============================================

// Claim - Insurance claim records
model Claim {
  id               String          @id @default(cuid())
  organizationId   String
  patientId        String

  // Claim identification
  claimNumber      String          // Internal claim number
  externalClaimId  String?         // Clearinghouse/payer claim ID

  // Claim type
  claimType        ClaimType       @default(PROFESSIONAL)
  placeOfService   String?         // POS code

  // Service period
  serviceStartDate DateTime
  serviceEndDate   DateTime

  // Provider info
  renderingProviderId  String?     // NPI of rendering provider
  billingProviderId    String?     // NPI of billing provider
  facilityId           String?

  // Payer info
  payerId          String          // Insurance provider ID
  payerName        String?
  memberId         String?         // Patient's member ID
  groupNumber      String?

  // Amounts
  totalCharges     Decimal         @db.Decimal(10, 2)
  allowedAmount    Decimal?        @db.Decimal(10, 2)
  paidAmount       Decimal?        @db.Decimal(10, 2)
  patientResponsibility Decimal?   @db.Decimal(10, 2)
  adjustments      Decimal?        @db.Decimal(10, 2)

  // Status
  status           ClaimStatus     @default(DRAFT)
  submittedAt      DateTime?
  acceptedAt       DateTime?
  paidAt           DateTime?

  // File/EDI info
  ediFileId        String?         // 837P file reference
  remittanceId     String?         // 835 remittance reference

  // Notes
  notes            String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  lines            ClaimLine[]
  denials          ClaimDenial[]
  audits           ClaimAudit[]
  submissions      ClaimSubmission[]

  @@unique([organizationId, claimNumber])
  @@index([organizationId])
  @@index([patientId])
  @@index([payerId])
  @@index([status])
  @@index([serviceStartDate])
  @@index([submittedAt])
  @@map("claims")
}

enum ClaimType {
  PROFESSIONAL    // 837P - Professional claims
  INSTITUTIONAL   // 837I - Institutional claims
}

enum ClaimStatus {
  DRAFT
  VALIDATED
  SUBMITTED
  ACCEPTED
  REJECTED
  IN_PROCESS
  PAID
  DENIED
  APPEALED
  VOIDED
}

// ClaimLine - Individual line items on a claim
model ClaimLine {
  id               String          @id @default(cuid())
  claimId          String
  organizationId   String

  // Line info
  lineNumber       Int

  // Service
  serviceDate      DateTime
  cptCode          String          // CPT/HCPCS code
  modifier1        String?
  modifier2        String?
  modifier3        String?
  modifier4        String?

  // Diagnosis
  diagnosisCodes   String[]        // ICD-10 codes

  // Charges
  units            Int             @default(1)
  chargeAmount     Decimal         @db.Decimal(10, 2)
  allowedAmount    Decimal?        @db.Decimal(10, 2)
  paidAmount       Decimal?        @db.Decimal(10, 2)

  // Status
  status           ClaimLineStatus @default(PENDING)
  denialReasonCode String?

  // Linked activity
  billableActivityId String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  claim            Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([organizationId])
  @@index([cptCode])
  @@map("claim_lines")
}

enum ClaimLineStatus {
  PENDING
  PAID
  DENIED
  ADJUSTED
}

// ClaimDenial - Denial tracking
model ClaimDenial {
  id               String          @id @default(cuid())
  claimId          String
  organizationId   String

  // Denial info
  denialCode       String          // CARC/RARC code
  denialReason     String          // Description
  denialCategory   DenialCategory

  // Amounts
  deniedAmount     Decimal         @db.Decimal(10, 2)

  // Appeal info
  appealable       Boolean         @default(true)
  appealDeadline   DateTime?
  appealStatus     AppealStatus?
  appealedAt       DateTime?
  appealNotes      String?

  // Resolution
  resolvedAt       DateTime?
  resolution       String?

  receivedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  claim            Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([organizationId])
  @@index([denialCategory])
  @@index([appealStatus])
  @@map("claim_denials")
}

enum DenialCategory {
  ELIGIBILITY
  AUTHORIZATION
  MEDICAL_NECESSITY
  DUPLICATE
  TIMELY_FILING
  BUNDLING
  CODING_ERROR
  MISSING_INFO
  NON_COVERED
  OTHER
}

enum AppealStatus {
  PENDING
  SUBMITTED
  IN_REVIEW
  APPROVED
  DENIED
  WITHDRAWN
}

// PayerRule - Payer-specific billing rules
model PayerRule {
  id               String          @id @default(cuid())
  organizationId   String
  payerId          String          // Insurance provider code
  payerName        String

  // Rule scope
  ruleType         PayerRuleType
  cptCode          String?         // Specific CPT or "*" for all

  // Rule content
  description      String
  requirement      Json            // Rule specification

  // Validation
  isActive         Boolean         @default(true)
  effectiveDate    DateTime?
  terminationDate  DateTime?

  // Actions
  autoApply        Boolean         @default(true) // Auto-apply during submission
  blockSubmission  Boolean         @default(false) // Block if rule fails

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId])
  @@index([payerId])
  @@index([ruleType])
  @@index([cptCode])
  @@index([isActive])
  @@map("payer_rules")
}

enum PayerRuleType {
  MODIFIER_REQUIRED
  AUTHORIZATION_REQUIRED
  FREQUENCY_LIMIT
  BUNDLING_RULE
  DIAGNOSIS_REQUIRED
  DOCUMENTATION_REQUIRED
  TIMELY_FILING
  PLACE_OF_SERVICE
}

// ClaimAudit - Audit trail for claim changes
model ClaimAudit {
  id               String          @id @default(cuid())
  claimId          String
  organizationId   String

  // Change info
  action           ClaimAuditAction
  field            String?         // Field that changed
  oldValue         String?
  newValue         String?

  // Context
  reason           String?
  notes            String?

  // User
  performedById    String?
  performedByName  String?

  performedAt      DateTime        @default(now())

  // Relations
  claim            Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([organizationId])
  @@index([action])
  @@index([performedAt])
  @@map("claim_audits")
}

enum ClaimAuditAction {
  CREATED
  UPDATED
  SUBMITTED
  RESUBMITTED
  VOIDED
  ADJUSTED
  APPEALED
  PAID
  DENIED
  CORRECTED
}

// ClaimSubmission - Clearinghouse submission records
model ClaimSubmission {
  id               String                @id @default(cuid())
  claimId          String
  organizationId   String

  // Clearinghouse info
  clearinghouse    String                // e.g., "Change Healthcare", "Availity"

  // Submission
  submissionType   SubmissionType        @default(ORIGINAL)
  submittedAt      DateTime              @default(now())

  // EDI file
  ediFileName      String?
  ediFileContent   String?               @db.Text // 837P content

  // Response
  status           SubmissionStatus      @default(PENDING)
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?

  // Tracking
  trackingNumber   String?
  batchId          String?

  responseContent  String?               @db.Text // 999/277 response

  // Relations
  claim            Claim                 @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([organizationId])
  @@index([status])
  @@index([submittedAt])
  @@map("claim_submissions")
}

enum SubmissionType {
  ORIGINAL
  CORRECTED
  REPLACEMENT
  VOID
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
  ERROR
}

// ============================================
// ANALYTICS & REPORTING
// ============================================

// ReportTemplate - Report builder templates
model ReportTemplate {
  id               String          @id @default(cuid())
  organizationId   String
  name             String
  description      String?

  // Template type
  reportType       ReportType
  category         String?         // e.g., "Clinical", "Financial", "Operational"

  // Configuration
  dataSource       String          // e.g., "patients", "vitals", "claims"
  columns          Json            // Column definitions
  filters          Json?           // Default filters
  groupBy          String[]        // Grouping fields
  sortBy           Json?           // Sort configuration

  // Visualization
  chartType        ChartType?
  chartConfig      Json?

  // Permissions
  isPublic         Boolean         @default(false)
  createdById      String

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  scheduledReports ScheduledReport[]

  @@index([organizationId])
  @@index([reportType])
  @@index([createdById])
  @@map("report_templates")
}

enum ReportType {
  PATIENT_LIST
  VITAL_SUMMARY
  ALERT_ANALYSIS
  BILLING_SUMMARY
  COMPLIANCE_REPORT
  POPULATION_HEALTH
  COHORT_ANALYSIS
  PROVIDER_PRODUCTIVITY
  DEVICE_UTILIZATION
  CUSTOM
}

enum ChartType {
  BAR
  LINE
  PIE
  DONUT
  AREA
  SCATTER
  TABLE
  HEATMAP
}

// ScheduledReport - Automated report generation
model ScheduledReport {
  id               String              @id @default(cuid())
  templateId       String
  organizationId   String
  name             String

  // Schedule
  frequency        ReportFrequency
  dayOfWeek        Int?                // 0-6 for weekly
  dayOfMonth       Int?                // 1-31 for monthly
  hour             Int                 @default(8) // Hour of day (0-23)
  timezone         String              @default("America/New_York")

  // Filters for this schedule
  filters          Json?
  dateRange        String?             // "last_7_days", "last_month", etc.

  // Delivery
  deliveryMethod   DeliveryMethod[]
  recipients       String[]            // Email addresses

  // Format
  format           ExportFormat        @default(PDF)

  // Status
  isActive         Boolean             @default(true)
  lastRunAt        DateTime?
  lastRunStatus    String?
  nextRunAt        DateTime?

  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  template         ReportTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  executions       ReportExecution[]

  @@index([organizationId])
  @@index([templateId])
  @@index([isActive])
  @@index([nextRunAt])
  @@map("scheduled_reports")
}

enum ReportFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum DeliveryMethod {
  EMAIL
  SFTP
  S3
  DASHBOARD
}

enum ExportFormat {
  PDF
  CSV
  XLSX
  JSON
}

// ReportExecution - Report generation history
model ReportExecution {
  id               String          @id @default(cuid())
  scheduledReportId String?
  organizationId   String

  // Report info
  reportName       String
  templateId       String?

  // Execution
  status           ExecutionStatus @default(PENDING)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  durationMs       Int?

  // Results
  recordCount      Int?
  fileUrl          String?
  fileSize         Int?

  // Errors
  errorMessage     String?

  // Context
  triggeredBy      String?         // "scheduled", "manual", userId
  parameters       Json?           // Parameters used

  // Relations
  scheduledReport  ScheduledReport? @relation(fields: [scheduledReportId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([scheduledReportId])
  @@index([status])
  @@index([startedAt])
  @@map("report_executions")
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// CohortDefinition - Patient cohort definitions
model CohortDefinition {
  id               String          @id @default(cuid())
  organizationId   String
  name             String
  description      String?

  // Cohort criteria
  criteria         Json            // Filter criteria

  // Stats (cached)
  patientCount     Int             @default(0)
  lastCalculatedAt DateTime?

  // Usage
  isActive         Boolean         @default(true)
  createdById      String

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  outcomes         CohortOutcome[]

  @@index([organizationId])
  @@index([isActive])
  @@map("cohort_definitions")
}

// CohortOutcome - Tracked outcomes for cohorts
model CohortOutcome {
  id               String          @id @default(cuid())
  cohortId         String
  organizationId   String

  // Outcome definition
  metricName       String          // e.g., "avg_bp_systolic", "hospitalization_rate"
  metricType       MetricType
  targetValue      Decimal?        @db.Decimal(10, 2)

  // Calculated values
  currentValue     Decimal?        @db.Decimal(10, 2)
  previousValue    Decimal?        @db.Decimal(10, 2)
  changePercent    Decimal?        @db.Decimal(5, 2)
  trend            String?         // "improving", "stable", "declining"

  // Time period
  periodStart      DateTime
  periodEnd        DateTime

  calculatedAt     DateTime        @default(now())

  // Relations
  cohort           CohortDefinition @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([organizationId])
  @@index([metricName])
  @@index([periodEnd])
  @@map("cohort_outcomes")
}

enum MetricType {
  AVERAGE
  COUNT
  PERCENTAGE
  RATE
  MEDIAN
  SUM
}

// PopulationHealthMetric - Population-level health metrics
model PopulationHealthMetric {
  id               String          @id @default(cuid())
  organizationId   String

  // Metric identification
  metricCode       String          // e.g., "BP_CONTROL_RATE", "A1C_TARGET"
  metricName       String
  category         String          // e.g., "Hypertension", "Diabetes"

  // Values
  numerator        Int             // Patients meeting criteria
  denominator      Int             // Total eligible patients
  rate             Decimal         @db.Decimal(5, 2) // Percentage

  // Benchmarks
  targetRate       Decimal?        @db.Decimal(5, 2)
  nationalBenchmark Decimal?       @db.Decimal(5, 2)

  // Time period
  periodType       String          // "monthly", "quarterly", "annual"
  periodStart      DateTime
  periodEnd        DateTime

  calculatedAt     DateTime        @default(now())

  @@unique([organizationId, metricCode, periodStart])
  @@index([organizationId])
  @@index([category])
  @@index([periodStart])
  @@map("population_health_metrics")
}

// ============================================
// ALERT INTELLIGENCE
// ============================================

// AlertScore - AI-based alert prioritization
model AlertScore {
  id               String          @id @default(cuid())
  alertId          String          @unique
  organizationId   String

  // Scores (0-100)
  priorityScore    Int             // Overall priority
  urgencyScore     Int             // Time-sensitivity
  severityScore    Int             // Clinical severity
  patientRiskScore Int             // Patient risk factor

  // Factors considered
  factors          Json            // { factor: weight, ... }

  // Classification
  predictedOutcome String?         // "needs_intervention", "self_resolving", etc.
  confidence       Decimal         @db.Decimal(3, 2) // 0.00-1.00

  // Model info
  modelVersion     String          @default("1.0")
  calculatedAt     DateTime        @default(now())

  // Relations
  alert            Alert           @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([priorityScore])
  @@index([calculatedAt])
  @@map("alert_scores")
}

// AlertWorkload - Workload balancing for clinical staff
model AlertWorkload {
  id               String          @id @default(cuid())
  userId           String
  organizationId   String

  // Current workload
  activeAlerts     Int             @default(0)
  criticalAlerts   Int             @default(0)
  pendingReview    Int             @default(0)

  // Capacity
  maxCapacity      Int             @default(50)
  availableCapacity Int            @default(50)

  // Performance
  avgResponseTime  Int?            // Minutes
  resolutionRate   Decimal?        @db.Decimal(5, 2) // Percentage

  // Status
  isAvailable      Boolean         @default(true)
  unavailableUntil DateTime?
  unavailableReason String?

  // Shift info
  shiftStart       String?         // "08:00"
  shiftEnd         String?         // "17:00"
  timezone         String          @default("America/New_York")

  lastUpdatedAt    DateTime        @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([isAvailable])
  @@index([availableCapacity])
  @@map("alert_workloads")
}

// AlertSlaConfig - SLA queue configuration
model AlertSlaConfig {
  id               String          @id @default(cuid())
  organizationId   String
  name             String

  // SLA criteria
  severity         AlertSeverity
  vitalTypes       VitalType[]

  // Response time SLAs (minutes)
  acknowledgeSla   Int             // Time to acknowledge
  resolveSla       Int             // Time to resolve
  escalateSla      Int             // Time before auto-escalation

  // Alerts
  warningThreshold Int             // Minutes before warning

  // Priority
  priority         Int             @default(0)
  isActive         Boolean         @default(true)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId])
  @@index([severity])
  @@index([isActive])
  @@map("alert_sla_configs")
}

// AlertDeduplication - Track duplicate alert suppression
model AlertDeduplication {
  id               String          @id @default(cuid())
  organizationId   String
  patientId        String

  // Dedup key
  alertType        AlertType
  vitalType        VitalType?
  dedupKey         String          // Hash of alert characteristics

  // First alert
  originalAlertId  String          @unique
  originalCreatedAt DateTime

  // Suppressed count
  suppressedCount  Int             @default(0)
  lastSuppressedAt DateTime?

  // Window
  windowStart      DateTime
  windowEnd        DateTime
  windowMinutes    Int             @default(60) // Dedup window

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  originalAlert    Alert           @relation(fields: [originalAlertId], references: [id], onDelete: Cascade)

  @@unique([organizationId, patientId, dedupKey, windowStart])
  @@index([organizationId])
  @@index([patientId])
  @@index([dedupKey])
  @@map("alert_deduplications")
}

// ============================================
// DEVICE LOGISTICS & OPERATIONS
// ============================================

// DeviceInventory - Device inventory management
model DeviceInventory {
