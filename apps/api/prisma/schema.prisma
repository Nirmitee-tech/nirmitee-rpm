  createdBy  User              @relation("CarePlanCreatedBy", fields: [createdById], references: [id])
  approvedBy User?             @relation("CarePlanApprovedBy", fields: [approvedById], references: [id])
  versions   CarePlanVersion[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@map("care_plans")
}

model CarePlanVersion {
  id              String    @id @default(cuid())
  carePlanId      String
  organizationId  String // Required for multi-tenant RLS
  version         Int
  goals           Json // Array of care goals
  vitalThresholds Json // Thresholds for each vital type
  medications     Json? // Medication list
  instructions    String?
  effectiveDate   DateTime
  expiryDate      DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@unique([carePlanId, version])
  @@index([carePlanId])
  @@index([organizationId])
  @@index([effectiveDate])
  @@map("care_plan_versions")
}

enum CarePlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// ============================================
// RPM - PATIENT ASSESSMENTS
// ============================================

model Assessment {
  id             String           @id @default(cuid())
  patientId      String
  organizationId String
  type           AssessmentType
  status         AssessmentStatus @default(IN_PROGRESS)
  score          Int?
  maxScore       Int?
  responses      Json? // Assessment question responses
