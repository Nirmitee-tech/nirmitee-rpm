  batchNumber      String?
  manufacturedDate DateTime?
  expirationDate   DateTime?
  warrantyExpiry   DateTime?

  // Firmware
  firmwareVersion  String?

  // Location/status
  status           InventoryStatus     @default(IN_STOCK)
  location         String?             // Warehouse, clinic, etc.
  bin              String?             // Storage bin/shelf

